<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog's one primary action: the solid moon, as Play is. Focus is the one ring: a gap, then the ring, inside the button's bounds so a dialog never clips it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><corners android:radius="@dimen/nj_radius_capsule" /><stroke android:width="@dimen/dialog_button_ring" android:color="?attr/glassRingOnMoon" /></shape></item>
            <item android:left="@dimen/dialog_button_gap" android:top="@dimen/dialog_button_gap" android:right="@dimen/dialog_button_gap" android:bottom="@dimen/dialog_button_gap"><shape><corners android:radius="@dimen/nj_radius_capsule" /><gradient android:angle="270" android:startColor="@color/nj_color_moon_hi" android:endColor="@color/glass_moon_low" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true" android:drawable="@drawable/dialog_button_moon_pressed" />
    <item android:state_hovered="true" android:drawable="@drawable/dialog_button_moon_pressed" />
    <item android:state_enabled="false"><shape><corners android:radius="@dimen/nj_radius_capsule" /><solid android:color="?attr/glassControlFill" /></shape></item>
    <item><shape><corners android:radius="@dimen/nj_radius_capsule" /><gradient android:angle="270" android:startColor="@color/nj_color_moon_hi" android:endColor="@color/glass_moon_low" /></shape></item>
</selector>
