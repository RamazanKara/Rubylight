<?xml version="1.0" encoding="utf-8"?>
<!-- The two weights the design uses. Bold text picks 600 and is not thickened on top. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/figtree_400" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/figtree_400" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/figtree_600" android:fontStyle="normal" android:fontWeight="600"
        app:font="@font/figtree_600" app:fontStyle="normal" app:fontWeight="600" />
</font-family>
