+/* Nightjar patch (window target): whether this frame may draw into its swapchain image, settled on
+ * its first use of the window's target.
+ *
+ * Video only (PQ present only): the app sets the boolean renderer property SDL.renderer.gpu.video_only
+ * before it queues anything on the window's target for a frame (between SDL_RenderPresent and the
+ * frame's first clear or draw there) and leaves it alone until that frame's present. It is read here,
+ * once a frame, on the frame's first run of commands on the window's target; set later, it counts
+ * from the next frame. True on a renderer with the PQ present means the app promises that every draw
+ * of this frame on the window's target is its own SDL_GPURenderState writing BT.2020 PQ (the PQ
+ * pass's encode of scRGB, 1.0 = 80 nits, in pq_present.hlsl): the output colorspace, HDR headroom
+ * and SDR white point properties stay what they are (SRGB_LINEAR), and the app's shader works in
+ * them before its PQ encode, so the frame looks the same as through the back buffer. Such a frame
+ * takes its HDR10 swapchain image as the window's target as SDR and scRGB frames do, and skips the
+ * back buffer and the PQ pass; when it cannot (a resize, read_back, no image) it draws into the back
+ * buffer, which then holds PQ and is blitted as it is. A clear of the window's target is PQ-encoded
+ * by SDL. SDL's own draws (no render state) on the window's target would write linear light into PQ,
+ * so they are dropped with an error, counted in SDL.renderer.gpu.video_only_dropped_draws: the app
+ * draws the overlay, menus or anything else only in frames with video_only false. The value settled
+ * for the latest frame is in SDL.renderer.gpu.video_only_frame (false without the PQ present). */
+static bool GPU_FrameEligible(SDL_Renderer *renderer, GPU_RenderData *data)
+{
+    if (!data->frame.decided) {
+        SDL_PropertiesID props = SDL_GetRendererProperties(renderer);
+        data->frame.decided = true;
+        data->frame.video_only = data->pq.pipeline && SDL_GetBooleanProperty(props, "SDL.renderer.gpu.video_only", false);
+        data->frame.eligible = data->window && (!data->pq.pipeline || data->frame.video_only) &&
+                               !SDL_GetBooleanProperty(props, "SDL.renderer.gpu.read_back", false);
+        if (data->pq.pipeline) {
+            SDL_SetBooleanProperty(props, "SDL.renderer.gpu.video_only_frame", data->frame.video_only);
+        }
+    }
+    return data->frame.eligible;
+}
+
+/* Nightjar patch (window target): ST 2084 of a linear scRGB colour, as the PQ pass encodes it
+ * (pq_present.hlsl: BT.709 to BT.2020, 1.0 = 80 nits), for a clear in a video-only frame. */
+static float GPU_PQ(float nits)
+{
+    const float m1 = 2610.0f / 16384.0f;
+    const float m2 = 2523.0f / 4096.0f * 128.0f;
+    const float c1 = 3424.0f / 4096.0f;
+    const float c2 = 2413.0f / 4096.0f * 32.0f;
+    const float c3 = 2392.0f / 4096.0f * 32.0f;
+    const float y = SDL_powf(SDL_clamp(nits / 10000.0f, 0.0f, 1.0f), m1);
+    return SDL_powf((c1 + c2 * y) / (1.0f + c3 * y), m2);
+}
+
+static void GPU_EncodePQ(SDL_FColor *color)
+{
+    const float r = 0.6274040f * color->r + 0.3292820f * color->g + 0.0433136f * color->b;
+    const float g = 0.0690970f * color->r + 0.9195400f * color->g + 0.0113612f * color->b;
+    const float b = 0.0163916f * color->r + 0.0880132f * color->g + 0.8955950f * color->b;
+    color->r = GPU_PQ(SDL_max(r, 0.0f) * 80.0f);
+    color->g = GPU_PQ(SDL_max(g, 0.0f) * 80.0f);
+    color->b = GPU_PQ(SDL_max(b, 0.0f) * 80.0f);
+}
+
+/* Nightjar patch (window target): acquires the frame's swapchain image, outside any pass. The frame
+ * draws into it when it matches the back buffer's size and format (RGB10A2, the PQ pass's target, for
+ * a video-only frame); otherwise (a resize, or no image) it draws into the back buffer and the present
+ * blits as before. */
+static SDL_GPUTexture *GPU_AcquireFrameTarget(GPU_RenderData *data)
+{
+    /* Latency: V-Sync's (FIFO's) wait moves from the present to this acquire, so no flush of the
+     * window's target may come before a frame's late CPU work (its newest picture or input). */
+    const SDL_GPUTextureFormat format = data->frame.video_only ? SDL_GPU_TEXTUREFORMAT_R10G10B10A2_UNORM : data->backbuffer.format;
+    data->frame.tried = true;
+    if (!SDL_WaitAndAcquireGPUSwapchainTexture(data->state.command_buffer, data->window, &data->frame.texture, &data->frame.width, &data->frame.height)) {
+        SDL_LogError(SDL_LOG_CATEGORY_RENDER, "Failed to acquire swapchain texture: %s", SDL_GetError());
+        data->frame.texture = NULL;
+    }
+    data->frame.format = SDL_GetGPUSwapchainTextureFormat(data->device, data->window);
+    data->frame.direct = data->frame.texture != NULL &&
+                         data->frame.width == data->backbuffer.width && data->frame.height == data->backbuffer.height &&
+                         data->frame.format == format;
+    return data->frame.direct ? data->frame.texture : data->backbuffer.texture;
+}
