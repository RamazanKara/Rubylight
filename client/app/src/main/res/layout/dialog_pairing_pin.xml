<?xml version="1.0" encoding="utf-8"?>
<!-- The PIN another device shows: a digit pad a gamepad can reach, filled in by PairingDialogs. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingStart="@dimen/space_xl" android:paddingEnd="@dimen/space_xl"
        android:paddingTop="@dimen/space_s" android:paddingBottom="@dimen/space_s">
        <!-- Where the request came from, then the waiting line with the device's name: two lines at most, so a long name
             leaves Approve and Deny in the window. -->
        <TextView android:id="@+id/pairing_pin_from" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="?attr/colorOnSurface" />
        <com.limelight.ui.PinSlots android:id="@+id/pairing_pin_value" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m" />
        <GridLayout android:id="@+id/pairing_pin_pad" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" android:columnCount="3" android:layoutDirection="ltr" />
    </LinearLayout>
</ScrollView>
