<?xml version="1.0" encoding="utf-8"?>
<!-- The title on a focused poster fades in over 120 ms and out over 90 ms, with the same state as the ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1" android:duration="120" android:valueType="floatType" />
    </item>
    <item android:state_focused="true" android:state_enabled="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1" android:duration="120" android:valueType="floatType" />
    </item>
    <item android:state_selected="true" android:state_enabled="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1" android:duration="120" android:valueType="floatType" />
    </item>
    <item android:state_hovered="true" android:state_enabled="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1" android:duration="120" android:valueType="floatType" />
    </item>
    <item>
        <objectAnimator android:propertyName="alpha" android:valueTo="0" android:duration="90" android:valueType="floatType" />
    </item>
</selector>
