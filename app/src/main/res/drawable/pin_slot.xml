<?xml version="1.0" encoding="utf-8"?>
<!-- A PIN slot: the control tint, and the next one to fill wears the focus ring around its gap. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item><shape><corners android:radius="@dimen/nj_radius_control" /><stroke android:width="@dimen/dialog_button_ring" android:color="?attr/glassRing" /></shape></item>
            <item android:left="@dimen/dialog_button_gap" android:top="@dimen/dialog_button_gap" android:right="@dimen/dialog_button_gap" android:bottom="@dimen/dialog_button_gap">
                <shape><corners android:radius="@dimen/pin_slot_inner_radius" /><solid android:color="?attr/glassControlFill" /></shape>
            </item>
        </layer-list>
    </item>
    <item><shape><corners android:radius="@dimen/nj_radius_control" /><solid android:color="?attr/glassControlFill" /><stroke android:width="1dp" android:color="?attr/glassControlRim" /></shape></item>
</selector>
