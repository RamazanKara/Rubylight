<?xml version="1.0" encoding="utf-8"?>
<!-- A row of TV Settings' rail: its icon and name. The section shown has the selected pill behind it (SettingsRail), which
     slides between rows; the D-pad's row is ringed. The pane says the rest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/settings_section_min_height"
    android:gravity="center_vertical" android:paddingStart="@dimen/space_l" android:paddingEnd="@dimen/space_l"
    android:descendantFocusability="blocksDescendants" android:background="@drawable/tv_settings_rail_row">
    <ImageView android:id="@android:id/icon" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginEnd="@dimen/space_l" app:tint="@color/tv_rail_icon" android:duplicateParentState="true"
        android:importantForAccessibility="no" />
    <TextView android:id="@android:id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:maxLines="1" android:ellipsize="end" android:duplicateParentState="true"
        android:textAppearance="@style/TextAppearance.Nightjar.Glass.TvRailRow" android:textColor="@color/tv_rail_title" />
</LinearLayout>
