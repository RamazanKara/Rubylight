    <string name="title_list_osc_style">Controller style</string>
    <string name="summary_list_osc_style">“Modern” başparmağınızı izleyen çubuklar ve ikisine birden basabileceğiniz A/B/X/Y düğmeleri sunar. “Classic” özgün düzeni korur; ikisi de bilgisayara aynı oyun kumandasını gönderir.</string>
