Say how long the host has been silent, and end a stream from the outside. The peer timeout has to
outlast every Wi-Fi dropout, so the client tells a PC that is gone from one that is only quiet
itself (HostLossWatch): LiGetControlSilenceMs() is what it watches, and LiEndStream() ends the
stream through the one termination callback, so a timeout at the same moment reports only once.
Applies after network-grace-input.patch.

--- a/src/ControlStream.c
+++ b/src/ControlStream.c
@@ -749,6 +749,22 @@ bool isControlContactLost(void) {
     lastReceiveTime = currentPeer->lastReceiveTime;
     return lastReceiveTime != 0 && ENET_TIME_DIFFERENCE(enet_time_get(), lastReceiveTime) >= INPUT_CONTACT_LOST_MS;
 }
+
+unsigned int LiGetControlSilenceMs(void) {
+    ENetPeer* currentPeer = peer;
+    enet_uint32 lastReceiveTime;
+
+    // Read without enetMutex like isControlContactLost(): a torn read shifts it by one tick.
+    if (currentPeer == NULL || currentPeer->state != ENET_PEER_STATE_CONNECTED) {
+        return 0;
+    }
+    lastReceiveTime = currentPeer->lastReceiveTime;
+    return lastReceiveTime != 0 ? ENET_TIME_DIFFERENCE(enet_time_get(), lastReceiveTime) : 0;
+}
+
+void LiEndStream(int errorCode) {
+    ListenerCallbacks.connectionTerminated(errorCode);
+}

