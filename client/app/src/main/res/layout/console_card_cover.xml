<?xml version="1.0" encoding="utf-8"?>
<!-- A game: its 2:3 cover and a caption. ShelfAdapter sets the cover's height. -->
<com.limelight.ui.CoverCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_s" android:focusable="true" android:clickable="true"
    android:defaultFocusHighlightEnabled="false" android:descendantFocusability="blocksDescendants">
    <FrameLayout android:id="@+id/console_cover_frame" android:layout_width="match_parent" android:layout_height="160dp"
        android:background="?attr/glassPlaceholder">
            <com.limelight.ui.PosterImageView android:id="@+id/console_cover" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <TextView android:id="@+id/console_cover_text" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:padding="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.Nightjar.Title" android:textColor="@color/nj_color_label"
                android:maxLines="4" android:ellipsize="end" android:importantForAccessibility="no" />
            <!-- Running or Suspended: a dot in the foot corner, where it hides no title. -->
            <com.limelight.ui.StatusDisc android:id="@+id/console_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:layout_margin="7dp" android:visibility="gone" android:importantForAccessibility="no" />
            <!-- The top end: a favourite's star, then the store's glyph (or name) in the corner. -->
            <LinearLayout android:id="@+id/console_marks" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_s" android:orientation="horizontal">
                <ImageView android:id="@+id/console_star" android:layout_width="@dimen/card_chip_height"
                    android:layout_height="@dimen/card_chip_height" android:layout_marginEnd="@dimen/space_xs"
                    android:padding="5dp" android:background="@drawable/bg_card_star"
                    android:src="@drawable/ic_star_filled" app:tint="@color/nj_color_moon"
                    android:visibility="gone" android:importantForAccessibility="no" />
                <TextView android:id="@+id/console_store_mark" style="@style/Widget.Nightjar.CardChip"
                    android:visibility="gone" />
            </LinearLayout>
            <!-- Not installed, or what adding takes. -->
            <TextView android:id="@+id/console_store" style="@style/Widget.Nightjar.CardChip"
                android:layout_gravity="bottom|start" android:layout_margin="@dimen/space_s"
                android:visibility="gone" />
    </FrameLayout>
    <com.limelight.ui.MarqueeLabel android:id="@+id/console_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s" android:paddingStart="2dp" android:paddingEnd="2dp"
        android:maxLines="1" android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/console_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="2dp" android:paddingEnd="2dp" android:visibility="gone"
        android:maxLines="1" android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Nightjar.Caption" android:textColor="?attr/colorOnSurfaceVariant"
        android:importantForAccessibility="no" />
</com.limelight.ui.CoverCard>
