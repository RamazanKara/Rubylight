<!-- A grouped row: the list insets it to its group's edge (settings_row_focus), GroupedListView draws the group behind it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/settings_row_min_height"
    android:descendantFocusability="blocksDescendants"
    android:background="@drawable/settings_row_press"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/settings_row_inset"
    android:paddingEnd="@dimen/settings_row_inset"
    android:paddingTop="@dimen/settings_row_padding"
    android:paddingBottom="@dimen/settings_row_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="?attr/nightjarFaceStrong"
            android:textAppearance="@style/TextAppearance.Nightjar.Body"
            android:textColor="@color/text_on_surface" />
        <com.limelight.preferences.ExpandingSummaryView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="@integer/settings_summary_lines"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Nightjar.Supporting"
            android:textColor="@color/text_on_surface_variant" />
    </LinearLayout>
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</LinearLayout>
