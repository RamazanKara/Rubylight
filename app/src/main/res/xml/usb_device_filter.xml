<?xml version="1.0" encoding="utf-8"?>
<!-- The controllers and adapters Nightjar drives itself (UsbDriverService). Declared, the USB permission dialog offers
     "Always allow". Matched by what each driver claims (its canClaimDevice), not by vendor alone: a vendor-wide entry also
     matched that vendor's keyboards, mice, webcams and headsets, and Android offered to open Nightjar for each of them.
     A class, subclass and protocol entry matches a device with any interface of that kind. Android reads the ids as decimal. -->
<resources>
    <!-- Xbox One and Series controllers and the Xbox Wireless Adapter: vendor-specific interface 71/208 (XboxOneController). -->
    <usb-device class="255" subclass="71" protocol="208" />
    <!-- Wired Xbox 360 controllers: 93/1 (Xbox360Controller). -->
    <usb-device class="255" subclass="93" protocol="1" />
    <!-- Xbox 360 wireless receiver: 93/129 (Xbox360WirelessDongle). -->
    <usb-device class="255" subclass="93" protocol="129" />
    <!-- DualSense and DualSense Edge: Sony 0x054c, 0x0ce6 and 0x0df2 (DualSenseController). -->
    <usb-device vendor-id="1356" product-id="3302" />
    <usb-device vendor-id="1356" product-id="3570" />
    <!-- Switch Pro Controller: Nintendo 0x057e, 0x2009 (SwitchProController). -->
    <usb-device vendor-id="1406" product-id="8201" />
</resources>
