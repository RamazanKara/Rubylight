    <string name="pacing_balanced_alt">平衡並限制 FPS</string>
    <string name="pacing_smoothness">最流暢的影像 (延遲較高)</string>
    <string name="title_analog_scrolling">捲動用搖桿</string>
    <string name="summary_analog_scrolling">控制器滑鼠模式下用於捲動的搖桿；另一支搖桿移動指標。未指定捲動搖桿時，兩支搖桿都會移動指標。</string>
    <string name="analogscroll_none">兩個搖桿都移動滑鼠</string>
    <string name="analogscroll_right">右類比搖桿</string>
    <string name="analogscroll_left">左類比搖桿</string>
    <string name="latency_header">延遲 (ms)：平均/中位數/p95 (%1$d 個影格)</string>
    <string name="latency_queue_wait">佇列等待</string>
    <string name="latency_input_output">解碼時間</string>
    <string name="latency_output_render">顯示等待</string>
    <string name="latency_receive_render">用戶端延遲</string>
    <string name="latency_host_processing">主機處理</string>
    <string name="latency_host_processing_send">主機到網路</string>
    <string name="latency_host_split">主機排隊 / 編碼 / 傳送（平均）: %1$.2f / %2$.2f / %3$.2f</string>
    <string name="yuv444_fallback">此串流無法使用更清晰的彩色文字。</string>
    <string name="yuv444_fallback_hdr">開啟 HDR 時無法使用更清晰的彩色文字。HDR 優先。</string>
    <string name="title_virtual_display">虛擬顯示器</string>
    <string name="summary_virtual_display">電腦從自己的一個虛擬顯示器進行串流，它與串流的解析度和影格速率一致，不受電腦所接螢幕的影響。關閉則交由電腦的顯示設定決定。</string>
    <string name="title_vrr">可變更新率</string>
    <string name="summary_vrr">VRR：在 G-Sync、FreeSync 或自動調整更新率的螢幕上，影格不必等待下一次螢幕更新即可顯示，且不使用「影格調步」。「開啟」在遊戲繪製每個影格的時刻顯示它，讓動態保持平穩，會增加約 1 到 4 毫秒延遲；「最快」在每個影格一到達時就顯示，延遲最低。沒有自適應更新率的螢幕會改用其最高更新率執行；若最高更新率會卡頓、PC 傳送幀時間且螢幕能不黑屏切換，則改用遊戲幀率的較低倍數。每一幀仍要等待下一次更新（120 Hz 下不到 8.3 毫秒）。螢幕只能維持 60 Hz 時請保持關閉，幀同步已足夠。</string>
    <string-array name="vrr_choice_names">
        <item>關閉</item>
        <item>開啟</item>
        <item>最快</item>
    </string-array>
    <string name="summary_vrr_unavailable">需要 Android 6 或更新版本。</string>
    <string name="title_host_frame_times">依電腦的影格時間顯示畫面</string>
    <string name="summary_host_frame_times">將每個影格短暫保留，讓它在遊戲繪製的時刻顯示，使動態更平穩。會增加幾毫秒延遲；動態看起來不均勻時請開啟。</string>
    <string name="title_content_rate_frame_rate">讓螢幕符合遊戲影格率</string>
    <string name="summary_content_rate_frame_rate">將螢幕切換為符合遊戲實際影格速率的更新率，例如在 120 FPS 的串流中為 60 FPS 的遊戲使用 60 Hz。需要電腦支援。</string>
    <string name="title_virtual_display_scale">電腦轉譯解析度</string>
    <string name="summary_virtual_display_scale">電腦繪製的大小，以串流解析度的百分比表示；傳送的視訊大小不變。高於 100 時，電腦繪製的像素比傳送的多；低於 100 時則較少。</string>
    <string name="title_virtual_display_dpi">電腦顯示縮放</string>
    <string name="summary_virtual_display_dpi">電腦虛擬顯示器上的文字和介面大小；解析度不變。此螢幕上文字太小時請調高。「依照電腦」沿用電腦的設定。</string>
    <string name="virtual_display_dpi_pc_own">依照電腦</string>
