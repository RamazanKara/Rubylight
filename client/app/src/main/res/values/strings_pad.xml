<resources>
    <string name="title_list_osc_style">Controller style</string>
    <string name="summary_list_osc_style">Modern has sticks that follow your thumb and face buttons you can press two at a time. Classic keeps the original layout; both send the same gamepad to the PC.</string>
    <string name="osc_style_classic">Classic</string>
    <string name="osc_style_modern">Modern</string>
    <string name="title_list_osc_stick_mode">Modern controller sticks</string>
    <string name="summary_list_osc_stick_mode">Floating centers a stick where your thumb lands, so you need not hit it exactly. Pick Fixed if you prefer to aim at the drawn stick.</string>
    <string name="osc_stick_floating">Floating</string>
    <string name="osc_stick_fixed">Fixed</string>
    <string name="title_seekbar_osc_stick_deadzone">Modern controller stick deadzone</string>
    <string name="summary_seekbar_osc_stick_deadzone">How far a thumb moves before a stick answers. Raise it if a resting thumb drifts the camera or character; lower it for finer aim.</string>
