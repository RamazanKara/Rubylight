    <string name="title_show_touchpad_button">显示触控板按钮</string>
    <string name="summary_show_touchpad_button">添加一个用于按下 PlayStation 手柄触控板的按钮。玩家 1 会因此以 PlayStation 手柄的身份连接到电脑；除非游戏需要这个按键，否则请保持关闭。</string>
    <string name="title_osc_steam_controls">Steam Controller 控件</string>
    <string name="summary_osc_steam_controls">为屏幕控件添加触控板、背键（L4、R4、L5、R5）和握把触摸。仅适用于手柄类型为 Steam Controller 的电脑；设为“自动”时，电脑可能选用 PlayStation 手柄。</string>
    <string name="title_reset_osc">重置控制按钮布局</string>
    <string name="dialog_title_reset_osc">重置布局</string>
    <string name="dialog_text_reset_osc">要将所有屏幕按钮恢复为默认大小和位置吗？为单个游戏保存的布局也会一并重置。</string>
    <string name="toast_reset_osc_success">屏幕控制按钮已重置为默认值</string>
    <string name="title_osc_opacity">不透明度</string>
    <string name="summary_osc_opacity">屏幕控制按钮的可见程度。调低可看到更多被它们遮住的游戏画面。</string>
    <string name="suffix_osc_opacity">%</string>
    <string name="title_checkbox_enable_pip">画中画</string>
    <string name="summary_checkbox_enable_pip">离开应用时，串流保持在小窗口中，屏幕控制按钮和叠加层会隐藏。关闭后，离开应用时串流会停止。</string>
    <string name="title_language_list">语言</string>
    <string name="title_checkbox_small_icon_mode">使用小封面图</string>
    <string name="summary_checkbox_small_icon_mode">在电脑的游戏库中一屏显示更多游戏。</string>
    <string name="title_quick_resume">快速继续</string>
    <string name="summary_quick_resume">选择正在运行游戏的电脑会直接回到该游戏，跳过游戏库。开启期间，可从电脑的菜单打开游戏库。</string>
    <string name="title_checkbox_enable_sops">游戏优化提示</string>
    <string name="summary_checkbox_enable_sops">允许电脑为串流调整游戏设置。请保持开启；如果电脑更改了游戏的设置而你想保留原来的设置，请关闭。</string>
    <string name="title_checkbox_host_audio">同时在电脑上播放音频</string>
    <string name="title_unlock_fps">显示所有帧率</string>
    <string name="title_checkbox_reduce_refresh_rate">允许降低刷新率</string>
    <string name="summary_checkbox_reduce_refresh_rate">允许屏幕使用仍能满足串流的最低刷新率（例如 60 FPS 用 60 Hz），以节省电量。关闭则保持最高刷新率，延迟更低。</string>
    <string name="title_checkbox_disable_warnings">隐藏连接警告</string>
    <string name="summary_checkbox_disable_warnings">串流期间不显示连接不佳的警告。连接已调整好、不再需要这些警告时，可以开启。</string>
    <string name="title_video_format">视频编解码器</string>
    <string name="summary_video_format">视频的压缩方式。请保持“自动”，除非画面停住或花屏；那时再试试 H.264，它是兼容性最好的编解码器。</string>
