<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_surface</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_subtle</item>
        <item name="colorControlNormal">@color/on_surface_variant</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlNormal">@color/on_surface_variant</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="android:textColorHint">@color/on_surface_variant</item>
        <item name="android:textColorAlertDialogListItem">@color/on_surface</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Nightjar.ScreenTitle</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Nightjar.ScreenTitle</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Nightjar.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Nightjar.Label</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Nightjar.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Nightjar.Supporting</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Nightjar.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Nightjar.Label</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Nightjar.Dialog</item>
        <item name="toolbarStyle">@style/Widget.Nightjar.Toolbar</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Nightjar</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Nightjar</item>
    </style>

    <style name="ThemeOverlay.Nightjar.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Dialog messages are read at arm's length or across a room: Body rather than Supporting. -->
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Nightjar.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/NightjarDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/NightjarDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/NightjarDialogButton</item>
    </style>

    <!-- Toolbar icons are white vectors; Widget.Material3.Toolbar does not tint the navigation icon, which left it
         invisible on the light surface. Menu item icons are tinted by app:iconTint in res/menu. -->
    <style name="Widget.Nightjar.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.Nightjar.ScreenTitle</item>
        <item name="subtitleTextColor">@color/on_surface_variant</item>
        <item name="android:minHeight">@dimen/top_app_bar_height</item>
        <!-- The 48dp navigation and action buttons centre their 24dp icons on the screen gutter;
             the title starts on the gutter, or 56dp in (phones) after a navigation icon. -->
        <item name="android:paddingStart">@dimen/top_app_bar_padding</item>
        <item name="android:paddingEnd">@dimen/top_app_bar_padding</item>
        <item name="contentInsetStart">@dimen/screen_gutter</item>
        <item name="contentInsetStartWithNavigation">56dp</item>
        <item name="contentInsetEnd">0dp</item>
        <item name="titleMarginStart">0dp</item>
        <item name="titleMarginEnd">@dimen/space_s</item>
        <!-- AppCompat's toolbar blocks focus on touchscreen devices, which kept D-pad and Tab focus
             out of Settings and Help and, once inside, trapped it in the bar. -->
        <item name="android:touchscreenBlocksFocus">false</item>
    </style>

    <style name="AddPcTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="NightjarDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="ShapeAppearance.Nightjar" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="LibraryCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
    </style>

    <style name="ToolbarIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/on_surface</item>
    </style>

    <style name="StreamBaseTheme" parent="AppTheme">
        <!-- Transparent streaming background to avoid extra overdraw -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Stream activity theme -->
    <style name="StreamTheme" parent="StreamBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
