<?xml version="1.0" encoding="utf-8"?>
<!-- The handheld's hero: the game in focus, large, with what can be done with it, and the games to continue beside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:clipChildren="false" android:clipToPadding="false"
    android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="6dp">
    <com.limelight.ui.CoverCard android:id="@+id/hero_cover" android:layout_width="129dp" android:layout_height="wrap_content"
        android:focusable="true" android:clickable="true" android:defaultFocusHighlightEnabled="false"
        android:descendantFocusability="blocksDescendants">
        <com.limelight.ui.CoverFrame android:id="@+id/console_cover_frame" android:layout_width="match_parent" android:layout_height="193dp">
            <com.limelight.ui.PosterImageView android:id="@+id/hero_cover_image" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <TextView android:id="@+id/hero_cover_text" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:padding="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.Nightjar.Title" android:textColor="@color/nj_color_label"
                android:maxLines="4" android:ellipsize="end" android:visibility="gone" android:importantForAccessibility="no" />
        </com.limelight.ui.CoverFrame>
    </com.limelight.ui.CoverCard>
    <LinearLayout android:layout_width="0dp" android:layout_height="193dp" android:layout_weight="1"
        android:layout_marginStart="21dp" android:orientation="vertical" android:gravity="bottom"
        android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/hero_chip_state" android:layout_width="wrap_content" android:layout_height="26dp"
                android:gravity="center_vertical" android:background="@drawable/glass_chip" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:drawablePadding="5dp" android:textAppearance="@style/TextAppearance.Nightjar.Label" android:textColor="?attr/colorOnSurface"
                android:layout_marginEnd="6dp" android:visibility="gone" />
            <TextView android:id="@+id/hero_chip_store" android:layout_width="wrap_content" android:layout_height="26dp"
                android:gravity="center_vertical" android:background="@drawable/glass_chip" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:textAppearance="@style/TextAppearance.Nightjar.Label" android:textColor="?attr/colorOnSurface" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/hero_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Nightjar.Glass.Hero" android:textColor="?attr/colorOnSurface" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="10dp" android:clipChildren="false" android:clipToPadding="false">
            <com.limelight.ui.GlassButton android:id="@+id/hero_play" style="@style/Widget.Nightjar.Glass.Play"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="147dp"
                android:minHeight="48dp" android:textSize="15sp" android:paddingStart="20dp" android:paddingEnd="20dp"
                app:iconSize="20dp" app:iconPadding="8dp" android:text="@string/library_play" />
            <com.limelight.ui.GlassButton android:id="@+id/hero_favourite" style="@style/Widget.Nightjar.Glass.Control"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp"
                android:text="@string/console_favourite_description" app:icon="@drawable/ic_glass_star" />
            <com.limelight.ui.GlassButton android:id="@+id/hero_quit" style="@style/Widget.Nightjar.Glass.Control"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp"
                android:text="@string/applist_menu_quit" app:icon="@drawable/ic_glass_power" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/hero_panel" android:layout_width="202dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/glass_group" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:layout_gravity="top" android:layout_marginStart="12dp">
        <TextView android:id="@+id/shelf_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Nightjar.Title" android:textColor="?attr/colorOnSurface"
            android:accessibilityHeading="true" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/shelf_cards"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never"
            android:focusable="false" android:descendantFocusability="afterDescendants" />
    </LinearLayout>
</LinearLayout>
