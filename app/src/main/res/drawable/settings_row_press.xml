<?xml version="1.0" encoding="utf-8"?>
<!-- A grouped row's press: the ripple stays inside the group's corners. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/nj_radius_control" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>
