    <string name="title_resolution_list">分辨率</string>
    <string name="summary_resolution_list">电脑发送的画面尺寸。越高越清晰，对网络和解码性能的要求也越高；串流卡顿时请调低。</string>
    <string name="title_fps_list">帧率</string>
    <string name="summary_fps_list">每秒帧数（FPS）。越高越流畅，也需要更快的网络和更强的解码性能；串流卡顿时请调低。</string>
    <string name="title_seekbar_bitrate">码率</string>
    <string name="suffix_seekbar_bitrate_mbps">Mbps</string>
    <string name="dialog_seekbar_bitrate">每秒的视频数据量。越高越清晰，也需要更快的网络；画面卡顿或花屏时请调低。</string>
    <string name="seekbar_decrease">减小</string>
    <string name="seekbar_increase">增大</string>
    <string name="seekbar_presets">预设</string>
    <string name="seekbar_presets_unit">预设（%1$s）</string>
    <string name="fps_suffix_fps">FPS</string>
    <string name="title_audio_config_list">声道</string>
    <string name="summary_audio_config_list">立体声，或 5.1、7.1 或 7.1.4 环绕声。使用耳机或两只扬声器时请选“立体声”；只有扬声器和电脑都已按环绕声设置好时，才选环绕声。</string>
    <string name="title_checkbox_enable_audiofx">允许系统音效</string>
    <string name="summary_checkbox_enable_audiofx">让 Android 均衡器和音效处理声音。可能增加音频延迟；除非你使用这类音效，否则请保持关闭。</string>
    <string name="category_gamepad_settings">手柄</string>
    <string name="summary_checkbox_multi_controller">开启：每个手柄都是独立的玩家，只有在连接了手柄时电脑才会识别到手柄。关闭：所有手柄都作为玩家 1，电脑始终识别到一个手柄。</string>
    <string name="title_checkbox_vibrate_fallback">用设备振动模拟手柄震动</string>
    <string name="summary_checkbox_vibrate_fallback">手柄没有震动马达时，由此设备振动来代替玩家 1 的手柄震动。如果你玩的时候手持此设备，请开启。</string>
    <string name="title_seekbar_vibrate_fallback_strength">设备振动强度</string>
    <string name="summary_seekbar_vibrate_fallback_strength">此设备振动的强度。</string>
    <string name="suffix_seekbar_vibrate_fallback_strength">%</string>
    <string name="title_seekbar_deadzone">摇杆死区</string>
    <string name="summary_seekbar_deadzone">忽略摇杆在中心附近的小幅移动。摇杆松开后仍有漂移时调高；想让小幅移动也生效时调低。游戏可能还会叠加自己的死区。</string>
    <string name="suffix_seekbar_deadzone">%</string>
    <string name="title_seekbar_trigger_deadzone">扳机死区</string>
    <string name="summary_seekbar_trigger_deadzone" formatted="false">忽略轻微的扳机按压。扳机松开后仍被判定为按下时调高；想让轻按也生效时调低。游戏可能还会叠加自己的死区。</string>
    <string name="title_checkbox_xb1_driver">USB 手柄驱动</string>
    <string name="summary_checkbox_xb1_driver">Nightjar 自带的驱动，用于通过 USB 连接的 Xbox 手柄，在 Android 本身不支持它们时使用。请保持开启；需要时 Android 会请求 USB 访问权限。</string>
    <string name="title_usb_dualsense_haptics">USB DualSense 音频和触觉反馈</string>
    <string name="summary_usb_dualsense_haptics">有线 DualSense 可播放游戏的触觉反馈（波形振动），其扬声器、耳机和麦克风可与电脑配合使用。需要电脑支持这些功能。</string>
    <string name="title_usb_dualsense">USB DualSense 驱动</string>
    <string name="summary_usb_dualsense">Nightjar 自行通过 USB 读取 DualSense，让游戏可以使用自适应扳机、震动和灯条。串流时 Android 会请求 USB 访问权限；蓝牙连接仍使用 Android 的输入。</string>
    <string name="usb_dualsense_permission_info">开始串流时请允许 USB 访问。\n否则自适应扳机将保持关闭。</string>
    <string name="usb_dualsense_enable">启用 USB 驱动</string>
    <string name="usb_dualsense_denied">没有 USB 访问权限；自适应扳机已关闭。\n请重新连接数据线后重试。</string>
    <string name="title_checkbox_usb_bind_all">始终使用 USB 驱动</string>
    <string name="summary_checkbox_usb_bind_all">即使是 Android 支持的 Xbox 手柄，也使用 Nightjar 的驱动。如果 USB 手柄通过 Android 没有震动，请开启，然后重新连接手柄。</string>
    <string name="title_checkbox_mouse_emulation">手柄鼠标模式</string>
    <string name="summary_checkbox_mouse_emulation">按住 Start 可让手柄在手柄模式和鼠标模式之间切换。如果在游戏中会误触发，请关闭；串流菜单中的“鼠标”磁贴仍可切换。</string>
    <string name="title_checkbox_flip_face_buttons">任天堂按键布局</string>
    <string name="summary_checkbox_flip_face_buttons">交换 A 与 B、X 与 Y。如果希望 Nintendo 式手柄的按键发送其上印的字母，请开启。</string>
    <string name="title_checkbox_gamepad_touchpad_as_mouse">手柄触控板用作鼠标</string>
    <string name="summary_checkbox_gamepad_touchpad_as_mouse">手柄的触控板（DualSense 等）像鼠标一样移动电脑的指针。游戏将不再收到它的触摸；玩要用到触控板的游戏时请保持关闭。</string>
    <string name="title_checkbox_gamepad_motion_sensors">体感控制</string>
    <string name="summary_checkbox_gamepad_motion_sensors">将手柄的陀螺仪和加速度计数据发送给游戏，用于体感瞄准。电脑可能因此把它当作 PlayStation 手柄；如果游戏显示的按键图标不对，请关闭。</string>
    <string name="title_checkbox_gamepad_motion_fallback">使用设备体感传感器</string>
    <string name="summary_checkbox_gamepad_motion_fallback">手柄没有陀螺仪和加速度计时，玩家 1 改用此设备的传感器，移动设备即可进行体感操作。电脑可能因此把该手柄当作 PlayStation 手柄。</string>
    <string name="category_input_settings">触控和鼠标</string>
    <string name="title_trackpad_speed">触控板速度</string>
    <string name="title_mouse_speed">鼠标速度</string>
    <string name="title_trackpad_sensitivity_x">触控板灵敏度 X</string>
    <string name="summary_trackpad_sensitivity_x">实体触控板（例如键盘保护套上的）的水平指针速度，叠加在“鼠标速度”之上。负值会反转方向；触控模式使用“触控板速度”。</string>
    <string name="title_trackpad_sensitivity_y">触控板灵敏度 Y</string>
    <string name="summary_trackpad_sensitivity_y">实体触控板（例如键盘保护套上的）的垂直指针速度，叠加在“鼠标速度”之上。负值会反转方向；触控模式使用“触控板速度”。</string>
    <string name="title_trackpad_scroll_speed">触控板滚动速度</string>
    <string name="summary_trackpad_scroll_speed">在实体触控板上以及在“触控板（实体触控板手势）”触控模式下，双指滚动的幅度。滚动过于灵敏时请调低。</string>
    <string name="title_trackpad_swap_axis">交换触控板 X 和 Y</string>
    <string name="summary_trackpad_swap_axis">交换实体触控板的 X 轴和 Y 轴。仅在上下滑动时指针却横向移动的情况下开启；触控模式不受影响。</string>
    <string name="title_native_touchpad">在电脑上使用触控板手势</string>
    <string name="summary_native_touchpad">将实体触控板上的手指动作发送到电脑，让电脑自己的手势在那里生效：双指滚动、三指和四指滑动。无法接收的电脑仍像以前一样收到指针移动。</string>
    <string name="stream_native_touchpad_fallback">此串流不接受触控板手指，因此触控板会移动鼠标。</string>
    <string name="title_checkbox_absolute_mouse_mode">鼠标模式</string>
    <string name="summary_checkbox_absolute_mouse_mode">“捕获”让指针留在串流中并发送相对移动，用鼠标转动视角的游戏需要这种方式。“桌面指针”像普通鼠标一样移动，适合桌面操作。</string>
    <string name="title_checkbox_mouse_nav_buttons">鼠标后退/前进按钮</string>
    <string name="summary_checkbox_mouse_nav_buttons">将鼠标的后退和前进按钮发送到电脑。如果右键因此失灵，请保持关闭：有些设备会把右键报告为后退。</string>
    <string name="category_on_screen_controls_settings">屏幕控制按钮</string>
    <string name="title_checkbox_show_onscreen_controls">显示屏幕控制按钮</string>
    <string name="title_checkbox_vibrate_osc">按下时振动</string>
    <string name="title_only_l3r3">仅显示 L3 和 R3</string>
    <string name="summary_only_l3r3">隐藏除 L3 和 R3（摇杆按下）外的所有屏幕按钮。仅在你的手柄只缺摇杆按下功能时开启。</string>
