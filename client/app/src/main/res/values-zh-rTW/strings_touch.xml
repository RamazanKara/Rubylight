<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="stream_touch_off_help">觸控已關閉。向後滑動或按返回鍵可開啟串流選單。</string>
    <string name="title_local_cursor_speed">本機游標速度</string>
    <string name="title_trackpad_acceleration">指標加速</string>
    <string name="summary_trackpad_acceleration">手指慢速移動時指標移動得較少，方便精確瞄準；快速滑動時指標移動得更遠。適用於「觸控板」和「本機游標」觸控模式；從下次串流開始套用。</string>
    <string name="title_trackpad_acceleration_curve">加速強度</string>
    <string-array name="trackpad_acceleration_curve_names">
        <item>輕</item>
        <item>中</item>
        <item>強</item>
    </string-array>
    <string name="title_trackpad_momentum">快速滑動後慣性滑行</string>
    <string name="summary_trackpad_momentum">快速滑動後，指標會繼續移動並逐漸減速；觸碰螢幕會讓它立即停下。適用於「觸控板」和「本機游標」觸控模式。</string>
    <string name="title_trackpad_momentum_glide">滑行距離</string>
    <string-array name="trackpad_momentum_glide_names">
        <item>短</item>
        <item>中</item>
        <item>長</item>
    </string-array>
    <string name="title_trackpad_area">觸控板區域</string>
    <string name="summary_trackpad_area">「觸控板」和「本機游標」手勢可以開始的螢幕區域；從其他位置開始的觸控會被忽略。選擇半邊螢幕，另一邊就可以放拇指。</string>
    <string-array name="trackpad_area_names">
        <item>全螢幕</item>
        <item>右半邊</item>
        <item>左半邊</item>
        <item>下半邊</item>
        <item>上半邊</item>
    </string-array>
    <string name="title_three_finger_tap">三指輕觸</string>
    <string name="summary_three_finger_tap">三指快速輕觸時執行的動作。「系統鍵盤」是 Android 的鍵盤；「PC 鍵盤」有 F 鍵、Ctrl 和 Win；「鍵盤與滑鼠」是附有按鍵和觸控板的面板。</string>
    <string-array name="three_finger_tap_names">
        <item>@string/desktop_controls_system_keyboard</item>
        <item>中鍵點擊</item>
        <item>@string/desktop_controls_open</item>
        <item>@string/stream_disabled</item>
        <item>@string/pc_keyboard_title</item>
    </string-array>
    <string name="stream_cursor_shape_rejected">Nightjar 無法繪製電腦的游標形狀，因此顯示預設箭頭。</string>
    <string name="title_four_finger_tap">四指輕點</string>
    <string name="summary_four_finger_tap">四指快速輕觸時執行的動作。「系統鍵盤」是 Android 的鍵盤；「PC 鍵盤」有 F 鍵、Ctrl 和 Win；「鍵盤與滑鼠」是附有按鍵和觸控板的面板。</string>
    <string name="title_multi_touch_finger_taps">多點觸控中的多指輕觸</string>
    <string name="summary_multi_touch_finger_taps">在「多點觸控」模式下，三指和四指輕觸會執行對應動作，不再作為觸控傳送到電腦。如果電腦上有程式會用到這些輕觸，請保持關閉。</string>
</resources>
