# Nightjar for Linux from the release tar.gz, as a Flatpak. packaging/linux/build-packages.sh fills
# in the version and the archive's SHA-256 and writes the result beside the packages;
# build-bundle.sh builds nightjar-desktop-<version>-<arch>.flatpak from it, which every release
# carries. Build and install it by hand with
#   flatpak-builder --user --install --install-deps-from=flathub build io.github.ramazankara.nightjar-<arch>.yml
# The settings live in ~/.var/app/io.github.ramazankara.nightjar/config/nightjar, apart from a
# native install's ~/.config/nightjar.
id: io.github.ramazankara.nightjar
runtime: org.freedesktop.Platform
# build-bundle.sh, check-bundle.sh and tools/hw/nuc-gamescope/flatpak.sh read the branch from here.
runtime-version: '25.08'
sdk: org.freedesktop.Sdk
command: nightjar
# The SDK has appstreamcli, not the appstream-compose that flatpak-builder 1.2 (Ubuntu
# 22.04, the release runner) runs; the metainfo file still ships in /app/share/metainfo.
appstream-compose: false
finish-args:
  # Hosts, mDNS discovery and Wake-on-LAN.
  - --share=network
  - --share=ipc
  - --socket=wayland
  - --socket=fallback-x11
  - --socket=pulseaudio
  # The GPU (VA-API, Vulkan), controllers and USB forwarding.
  - --device=all
  # SDL3 keeps the screen on during a stream.
  - --talk-name=org.freedesktop.ScreenSaver
  # Vulkan layer extensions (org.freedesktop.Platform.VulkanLayer.gamescope, whose WSI layer
  # offers gamescope's HDR swapchains in Steam's Game Mode) mount in /usr/lib/extensions/vulkan;
  # the Vulkan loader finds their manifests through XDG_DATA_DIRS.
  - --env=XDG_DATA_DIRS=/app/share:/usr/lib/extensions/vulkan/share:/usr/share:/usr/share/runtime/share:/run/host/user-share:/run/host/share
  # That layer talks to gamescope over its own Wayland socket (GAMESCOPE_WAYLAND_DISPLAY, in
  # XDG_RUNTIME_DIR), which --socket=wayland does not share; Flathub's Lutris grants it the same way.
  - --filesystem=xdg-run/gamescope-0:ro
modules:
  - name: nightjar
    buildsystem: simple
    # The archive's release binaries go in as they are: no stripping, no debug extension.
    build-options:
      strip: false
      no-debuginfo: true
    build-commands:
      - mkdir -p /app/lib/nightjar /app/bin /app/share
      - cp -a . /app/lib/nightjar/
      - cp -a /app/lib/nightjar/share/. /app/share/
      - rm -r /app/lib/nightjar/share
      - ln -s /app/lib/nightjar/nightjar /app/bin/nightjar
    sources:
      - type: archive
        url: https://github.com/RamazanKara/nightjar/releases/download/v@VERSION@/nightjar-desktop-@VERSION@-linux-@ARCH@.tar.gz
        sha256: '@SHA256@'
