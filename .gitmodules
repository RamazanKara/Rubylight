[submodule "third-party/nanors"]
	path = third-party/nanors
	url = https://github.com/sleepybishop/nanors.git
	branch = master
[submodule "third-party/moonlight-common-c"]
	path = third-party/moonlight-common-c
	url = https://github.com/moonlight-stream/moonlight-common-c.git
	branch = master
# Nightjar's own (client/.gitmodules), which the nightjar mirror keeps using.
[submodule "client/app/src/main/jni/moonlight-core/moonlight-common-c"]
	path = client/app/src/main/jni/moonlight-core/moonlight-common-c
	url = https://github.com/moonlight-stream/moonlight-common-c.git
[submodule "client/protocol/vendor/sdl3-src/SDL"]
	path = client/protocol/vendor/sdl3-src/SDL
	url = https://github.com/libsdl-org/SDL.git
	shallow = true
