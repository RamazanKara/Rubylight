<?xml version="1.0" encoding="utf-8"?>
<!-- The game, its PC and the one word. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/conn_stage"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal"
    android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter">
    <TextView android:id="@+id/conn_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
        android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Nightjar.Glass.Hero" android:textColor="?attr/colorOnSurface" />
    <TextView android:id="@+id/conn_pc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
        android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant" />
    <TextView android:id="@+id/conn_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
        android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Nightjar.Glass.Size17" android:textColor="?attr/colorOnSurface" />
    <TextView android:id="@+id/conn_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
        android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Nightjar.Caption" android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
