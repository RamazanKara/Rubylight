    <dimen name="stream_tile_min_width">70dp</dimen>
    <dimen name="stream_tile_min_height">58dp</dimen>
    <dimen name="stream_tile_gap">6dp</dimen>
    <dimen name="stream_tile_icon">20dp</dimen>
    <dimen name="stream_tile_icon_gap">2dp</dimen>
    <dimen name="stream_tile_pad_top">6dp</dimen>
    <dimen name="stream_tile_pad_bottom">5dp</dimen>
    <dimen name="stream_tile_pad_side">4dp</dimen>
    <dimen name="stream_tile_corner">@dimen/nj_radius_tile</dimen>
    <dimen name="stream_tile_cap_text">9sp</dimen>
    <dimen name="stream_tile_corner_inset">7dp</dimen>
    <dimen name="stream_menu_exit_height">44dp</dimen>
    <dimen name="stream_menu_close">40dp</dimen>
    <dimen name="stream_menu_margin">12dp</dimen>
    <dimen name="stream_menu_cover_width">36dp</dimen>
    <dimen name="stream_menu_cover_height">54dp</dimen>
    <dimen name="stream_menu_row_height">44dp</dimen>
    <dimen name="stream_menu_row_value">13sp</dimen>
    <dimen name="stream_menu_group_gap">10dp</dimen>
    <dimen name="stream_menu_title">18sp</dimen>
