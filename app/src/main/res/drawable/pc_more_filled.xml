<?xml version="1.0" encoding="utf-8"?>
<!-- More beside a running PC's Resume: the round control, the ring when the D-pad has stepped onto it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_hovered="true">
        <shape android:shape="oval">
            <solid android:color="?attr/glassControlFill" />
            <stroke android:width="?attr/nightjarCardFocusRingWidth" android:color="?attr/glassRing" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/glassControlFill" />
            <stroke android:width="1dp" android:color="?attr/glassControlRim" />
        </shape>
    </item>
</selector>
