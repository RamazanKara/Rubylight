<?xml version="1.0" encoding="utf-8"?>
<!--
    The Touch Controller Studio's dock (PadStudioInspector, PadEditorPanel): a bar with the grip, the layout's tools
    (Add, Preset, the mirror lock, Undo, More) and Reset, Cancel and Done, on one row or, on a narrow surface, two.
    Under it a tray that shows only when there is something to show: the picked control (pad_editor_control), the Add
    tiles or the layout's other choices (pad_editor_layout). The tray scrolls when the dock would not fit the surface;
    the bar always shows. The surface is baked: an opaque fill and a rim, no blur and no shadow over the stream.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="496dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pad_studio_inspector"
    android:orientation="vertical"
    android:padding="@dimen/space_s">

    <LinearLayout
        android:id="@+id/pad_studio_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/pad_studio_tools"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The grip: drag it to move the dock anywhere on the screen (PadEditorPanel). -->
            <FrameLayout
                android:id="@+id/pad_editor_grip"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/pad_edit_move_panel"
                android:importantForAccessibility="yes">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:alpha="0.6"
                    android:background="@drawable/bg_pad_editor_grip"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_studio_add"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checkable="true"
                android:contentDescription="@string/pad_edit_add"
                app:backgroundTint="@color/pad_studio_tool_fill"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/pad_studio_tool_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_editor_preset"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/pad_edit_preset"
                app:icon="@drawable/ic_tune"
                app:iconTint="@color/pad_studio_tool_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_studio_mirror"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checkable="true"
                android:contentDescription="@string/pad_edit_mirror"
                app:backgroundTint="@color/pad_studio_tool_fill"
                app:icon="@drawable/ic_pad_mirror"
                app:iconTint="@color/pad_studio_tool_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_studio_undo"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/library_undo"
                app:icon="@drawable/ic_pad_undo"
                app:iconTint="@color/pad_studio_tool_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_studio_more"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checkable="true"
                android:contentDescription="@string/stream_menu_more"
                app:backgroundTint="@color/pad_studio_tool_fill"
                app:icon="@drawable/ic_more_horiz"
                app:iconTint="@color/pad_studio_tool_tint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pad_editor_actions"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_editor_reset"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/pad_edit_reset"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/pad_studio_tool_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_editor_cancel"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@android:string/cancel"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/pad_studio_tool_tint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pad_editor_done"
                style="@style/Widget.Nightjar.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/pad_edit_done" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/pad_editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/pad_editor_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s">

            <!-- The picked control's name, or "All controls", and its size. -->
            <LinearLayout
                android:id="@+id/pad_studio_size_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pad_editor_selection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Nightjar.Title"
                    android:textColor="@color/night_on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad_editor_smaller"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/pad_edit_smaller"
                    app:icon="@drawable/ic_pad_smaller"
                    app:iconTint="@color/night_on_surface" />

                <TextView
                    android:id="@+id/pad_editor_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Nightjar.Label"
                    android:textColor="@color/night_on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad_editor_larger"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/pad_edit_larger"
                    app:icon="@drawable/ic_pad_larger"
                    app:iconTint="@color/night_on_surface" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pad_studio_opacity_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_osc_opacity"
                    android:textAppearance="@style/TextAppearance.Nightjar.Label"
                    android:textColor="@color/night_on_surface_variant" />

                <!-- The 7.0 slider: a thin track filled amber, a round white thumb (its radius and focus ring are set
                     in PadEditorPanel), and the value at the row's end at all times. -->
                <com.google.android.material.slider.Slider
                    android:id="@+id/pad_editor_opacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/title_osc_opacity"
                    android:stepSize="5"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/night_on_surface"
                    app:thumbElevation="0dp"
                    app:thumbTrackGapSize="0dp"
                    app:tickVisible="false"
                    app:trackColorActive="@color/night_primary"
                    app:trackColorInactive="@color/nj_pad_studio_inspector_rim"
                    app:trackHeight="@dimen/nj_size_slider_track"
                    app:trackStopIndicatorSize="0dp" />

                <TextView
                    android:id="@+id/pad_studio_opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:maxLines="1"
                    android:gravity="end"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.Nightjar.Label"
                    android:textColor="@color/night_on_surface" />
            </LinearLayout>

            <!-- How far around its box a control takes touches (#172): 100 % is the box, as before. -->
            <LinearLayout
                android:id="@+id/pad_studio_reach_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pad_edit_touch_area"
                    android:textAppearance="@style/TextAppearance.Nightjar.Label"
                    android:textColor="@color/night_on_surface_variant" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/pad_editor_reach"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/pad_edit_touch_area"
                    android:stepSize="25"
                    android:valueFrom="100"
                    android:valueTo="300"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/night_on_surface"
                    app:thumbElevation="0dp"
                    app:thumbTrackGapSize="0dp"
                    app:tickVisible="false"
                    app:trackColorActive="@color/night_primary"
                    app:trackColorInactive="@color/nj_pad_studio_inspector_rim"
                    app:trackHeight="@dimen/nj_size_slider_track"
                    app:trackStopIndicatorSize="0dp" />

                <TextView
                    android:id="@+id/pad_studio_reach_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:maxLines="1"
                    android:gravity="end"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.Nightjar.Label"
                    android:textColor="@color/night_on_surface" />
            </LinearLayout>

            <!-- The picked control: Split or Join, Hide, and for the pointer touchpad its two modes. -->
            <LinearLayout
                android:id="@+id/pad_editor_control"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_editor_split"
                        style="@style/Widget.Nightjar.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_s"
                        android:text="@string/pad_edit_split"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_editor_join"
                        style="@style/Widget.Nightjar.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_s"
                        android:text="@string/pad_edit_join"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pad_editor_hide"
                        style="@style/Widget.Nightjar.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pad_edit_hide"
                        app:icon="@drawable/ic_visibility_off" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pad_editor_pointer_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:layout_marginTop="@dimen/space_xs"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/pad_editor_mode_mouse"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/space_s"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pad_editor_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_m">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_mouse_pointer"
                            app:tint="@color/pad_editor_card_content" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pad_touchpad_mouse"
                                android:textAppearance="@style/TextAppearance.Nightjar.Label"
                                android:textColor="@color/pad_editor_card_content" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pad_touchpad_mouse_summary"
                                android:textAppearance="@style/TextAppearance.Nightjar.Caption"
                                android:textColor="@color/night_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pad_editor_mode_camera"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pad_editor_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_m">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pad_camera"
                            app:tint="@color/pad_editor_card_content" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_m"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pad_touchpad_camera"
                                android:textAppearance="@style/TextAppearance.Nightjar.Label"
                                android:textColor="@color/pad_editor_card_content" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pad_touchpad_camera_summary"
                                android:textAppearance="@style/TextAppearance.Nightjar.Caption"
                                android:textColor="@color/night_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pad_editor_zone_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/pad_editor_kbm_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Nothing picked: the Add tray's tiles, or the More tray's glyphs and where Done saves. -->
            <LinearLayout
                android:id="@+id/pad_editor_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- The Add tiles, grouped; PadEditorPanel builds them from the controls the layout leaves out. -->
                <LinearLayout
                    android:id="@+id/pad_editor_add"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- One row on a short surface, the switch below the chip on a tall one (PadEditorPanel). -->
                <LinearLayout
                    android:id="@+id/pad_editor_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/pad_editor_glyphs"
                        style="@style/Widget.Nightjar.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="false"
                        android:text="@string/pad_glyph_xbox"
                        app:chipIcon="@drawable/ic_gamepad"
                        app:chipIconTint="@color/night_on_surface"
                        app:chipIconVisible="true" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/pad_editor_this_game"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/pad_edit_this_game"
                        android:textAppearance="@style/TextAppearance.Nightjar.Body"
                        android:textColor="@color/night_on_surface" />
                </LinearLayout>

                <!-- Only with the connected controller: its own layout, shown while it is connected (#154). -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/pad_editor_this_controller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:visibility="gone"
                    android:textAppearance="@style/TextAppearance.Nightjar.Body"
                    android:textColor="@color/night_on_surface" />

                <!-- Removes that controller's own layout, leaving the game's and all games' layouts as they are. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pad_editor_forget_controller"
                    style="@style/Widget.Nightjar.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>

            <TextView
                android:id="@+id/pad_editor_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/pad_edit_hint"
                android:textAppearance="@style/TextAppearance.Nightjar.Caption"
                android:textColor="@color/night_on_surface_variant" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
