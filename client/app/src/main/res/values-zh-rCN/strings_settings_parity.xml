<?xml version="1.0" encoding="utf-8"?>
<!-- Settings shared with desktop Nightjar: Sharper colored text, Controllers, Mouse mode, When Nightjar
     opens, group names, row hints and notices. -->
<resources>
    <string name="title_sharp_color">更清晰的彩色文字</string>
    <string name="summary_sharp_color">完整的色彩细节（4:4:4），让彩色文字和细线保持清晰。它们看起来模糊时请开启；会占用更多解码性能，并需要电脑和设备支持。</string>
    <string-array name="sharp_color_names">
        <item>关闭</item>
        <item>开启</item>
    </string-array>
    <string name="title_controllers">手柄</string>
    <string name="summary_controllers">“各为一名玩家”让每个手柄各自成为一名玩家，适合绝大多数人。“同一玩家”让所有手柄都作为玩家 1；“关闭”则不向电脑发送任何手柄。</string>
    <string-array name="controllers_names">
        <item>关闭</item>
        <item>同一玩家</item>
        <item>各为一名玩家</item>
    </string-array>
    <string-array name="mouse_mode_names">
        <item>捕获</item>
        <item>桌面指针</item>
    </string-array>
    <string-array name="start_screen_names">
        <item>主页</item>
        <item>显示我的电脑</item>
        <item>继续上次的游戏</item>
        <item>选定的游戏</item>
    </string-array>
    <string name="summary_host_display_location">电脑如何把串流的虚拟显示器排在自己的显示器旁边。“独占”选项会在串流期间关闭电脑的显示器，串流结束后恢复。需要电脑支持。</string>
    <string name="summary_pace_calibration_row">找出并保存电脑的 PyroWave 帧能完整送达的最快节奏，适用于会丢失帧尾的连接，例如 USB 以太网扩展坞。需要一到三分钟。</string>
    <string name="summary_network_tests">测量延迟、抖动和丢包，电脑支持时还会测量下载速度。</string>
    <string name="settings_category_touch_mouse">触控和鼠标</string>
    <string name="settings_category_connection">连接</string>
    <string name="sharp_color_unavailable_pc">这台电脑不支持“更清晰的彩色文字”。</string>
    <string name="sharp_color_unavailable_device">此设备不支持“更清晰的彩色文字”。</string>
    <string name="sharp_color_stopped">“更清晰的彩色文字”已停止。正在关闭此功能并重新连接。</string>
    <string name="sharp_color_hdr_dropped">此串流为 SDR：在这台电脑上，HDR 无法与“更清晰的彩色文字”同时使用。</string>
    <string name="hint_show_onscreen_controls">覆盖在串流画面上的触控手柄，没有实体手柄也能玩。它会遮住部分画面；调低“不透明度”可看到更多游戏画面。</string>
    <string name="hint_mouse_speed">实体鼠标移动电脑指针的速度。各触控模式有各自的速度设置。</string>
    <string name="hint_trackpad_speed">“触控板”触控模式下的指针速度。</string>
    <string name="hint_local_cursor_speed">“本地光标”触控模式下的指针速度。默认值下，指针移动的距离与手指相同。</string>
    <string name="hint_trackpad_acceleration_curve">快速滑动时指针额外移动的距离。</string>
    <string name="hint_trackpad_momentum_glide">指针滑行的距离。</string>
    <string name="hint_pc_keyboard_size">屏幕上 PC 键盘占屏幕高度的比例。越大，按键越大；越小，能看到的串流画面越多。</string>
    <string name="hint_pc_keyboard_opacity">屏幕上 PC 键盘的透明程度。数值越低，越能看到它后面的串流画面。</string>
    <string name="hint_vibrate_osc">按下屏幕控制按钮时振动（“Classic”手柄的按键除外），前提是系统的触摸反馈已开启；没有实体手柄接收游戏的震动时，也由此设备振动。</string>
    <string name="hint_show_guide_button">在屏幕控制按钮中添加 Guide 按钮（Home 或 PS）。</string>
    <string name="hint_host_audio">串流时电脑的扬声器仍会发出声音。</string>
    <string name="hint_overlay_position">性能叠加层所在的角落。</string>
    <string name="summary_reset_all">将所有设置恢复为默认值；电脑、游戏、配置和语言会保留。</string>
</resources>
