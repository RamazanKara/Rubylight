<?xml version="1.0" encoding="utf-8"?>
<!-- A TV screen that closes: it fades out and shrinks to 97%. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@interpolator/tv_std">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="150" />
    <scale android:fromXScale="1" android:toXScale="0.97" android:fromYScale="1" android:toYScale="0.97"
        android:pivotX="50%" android:pivotY="50%" android:duration="150" />
</set>
