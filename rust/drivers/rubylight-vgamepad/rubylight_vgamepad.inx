; Copyright (c) 2026 Chase Payne (MIT)
; Adapted from Nonary/libvirtualgamepad for Rubylight.

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = rubylight_vgamepad.cat
DriverVer   = 01/01/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Rubylight,NT$ARCH$.10.0...19041,NT$ARCH$.10.0...22000

; Windows 10 (19041+): predates inbox WUDFRD filter sections, so adds WUDFRd upper filter directly.
[Rubylight.NT$ARCH$.10.0...19041]
%DeviceDesc% = RubylightVhfGamepad_Install_Win10, Root\RubylightVirtualGamepad

; Windows 11 (22000+): includes WUDFRD_UpperFilter alongside hidvhf.inf.
[Rubylight.NT$ARCH$.10.0...22000]
%DeviceDesc% = RubylightVhfGamepad_Install_Win11, Root\RubylightVirtualGamepad

; ================= Windows 10 19041 through Windows 10 ========================

[RubylightVhfGamepad_Install_Win10.NT]
Include   = hidvhf.inf
Needs     = vhfservice.NT
CopyFiles = UMDriverCopy

[RubylightVhfGamepad_Install_Win10.NT.HW]
Include = hidvhf.inf
Needs   = vhfservice.NT.HW
AddReg  = RubylightVhfGamepad_Install.AddReg

[RubylightVhfGamepad_Install_Win10.NT.Services]
Include    = hidvhf.inf
Needs      = vhfservice.NT.Services
AddService = WUDFRd,0x000001f8,WUDFRD_ServiceInstall

[RubylightVhfGamepad_Install_Win10.NT.Filters]
AddFilter = WUDFRd,,WUDFRd_UpperFilterPosition

[RubylightVhfGamepad_Install_Win10.NT.Wdf]
UmdfService                = rubylight_vgamepad,rubylight_vgamepad_Install
UmdfServiceOrder           = rubylight_vgamepad
UmdfImpersonationLevel     = Impersonation
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy     = CannotUseFsContexts

[WUDFRd_UpperFilterPosition]
FilterPosition = Upper

[WUDFRD_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

; ================================ Windows 11 ==================================

[RubylightVhfGamepad_Install_Win11.NT]
Include   = WUDFRD.inf,hidvhf.inf
Needs     = WUDFRD_UpperFilter.NT,vhfservice.NT
CopyFiles = UMDriverCopy

[RubylightVhfGamepad_Install_Win11.NT.HW]
Include = WUDFRD.inf,hidvhf.inf
Needs   = WUDFRD_UpperFilter.NT.HW,vhfservice.NT.HW
AddReg  = RubylightVhfGamepad_Install.AddReg

[RubylightVhfGamepad_Install_Win11.NT.Services]
Include = WUDFRD.inf,hidvhf.inf
Needs   = WUDFRD_UpperFilter.NT.Services,vhfservice.NT.Services

[RubylightVhfGamepad_Install_Win11.NT.Filters]
Include = WUDFRD.inf
Needs   = WUDFRD_UpperFilter.NT.Filters

[RubylightVhfGamepad_Install_Win11.NT.Wdf]
UmdfService                = rubylight_vgamepad,rubylight_vgamepad_Install
UmdfServiceOrder           = rubylight_vgamepad
UmdfImpersonationLevel     = Impersonation
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy     = CannotUseFsContexts

; ================================ Shared ======================================

[RubylightVhfGamepad_Install.AddReg]
; Permit interactive users to open controller handles; SYSTEM/Admins and UD (WUDFHost) retain full access.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)(A;;GA;;;UD)"

[rubylight_vgamepad_Install]
UmdfLibraryVersion = $UMDFVERSION$
ServiceBinary      = %13%\rubylight_vgamepad.dll

[UMDriverCopy]
rubylight_vgamepad.dll

[DestinationDirs]
UMDriverCopy   = 13
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
rubylight_vgamepad.dll = 1,,

[Strings]
ProviderName      = "Rubylight"
ManufacturerName  = "Rubylight"
DeviceDesc        = "Rubylight Virtual Gamepad"
DiskName          = "Rubylight Virtual Gamepad Driver Installation Disk"
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
