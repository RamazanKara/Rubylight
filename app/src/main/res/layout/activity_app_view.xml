<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:padding="8dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/library_back" style="@style/ToolbarIcon"
            android:nextFocusDown="@id/fragmentView"
            android:src="@drawable/ic_arrow_back" android:contentDescription="@string/settings_navigate_up" />
        <TextView android:id="@+id/appListText"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/ScreenTitle"
            android:accessibilityHeading="true" tools:targetApi="p" />
        <ImageButton android:id="@+id/library_search_button" style="@style/ToolbarIcon"
            android:src="@drawable/ic_library_search" android:contentDescription="@string/library_search" />
        <ImageButton android:id="@+id/library_options" style="@style/ToolbarIcon"
            android:src="@drawable/ic_library_more" android:contentDescription="@string/library_options" />
    </LinearLayout>
    <androidx.appcompat.widget.SearchView android:id="@+id/library_search"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:minHeight="48dp"
        android:visibility="gone" app:queryHint="@string/library_search" app:iconifiedByDefault="false"
        android:inputType="text" android:imeOptions="actionSearch" />
    <TextView android:id="@+id/library_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/on_surface_variant"
        android:visibility="gone" />
    <ProgressBar android:id="@+id/library_loading" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" />
    <LinearLayout android:id="@+id/library_status_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp"
        android:paddingBottom="8dp" android:visibility="gone">
    <TextView android:id="@+id/app_list_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/library_retry"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/library_retry" android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
