<?xml version="1.0" encoding="utf-8"?>
<!-- A list dialog's selector: the Settings rows' look inside the panel, a tinted row with the ring. No grey block on any form. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="@dimen/space_m" android:insetRight="@dimen/space_m">
            <shape><corners android:radius="@dimen/nj_radius_control" /><solid android:color="?attr/colorControlHighlight" /></shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetLeft="@dimen/space_m" android:insetRight="@dimen/space_m">
            <shape><corners android:radius="@dimen/nj_radius_control" /><solid android:color="?attr/glassControlFill" />
                <stroke android:width="?attr/nightjarFocusRingWidth" android:color="?attr/glassRing" /></shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
