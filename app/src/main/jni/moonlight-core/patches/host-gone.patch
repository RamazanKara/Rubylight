     ENetPacket* enetPacket;
     int err;
@@ -1330,6 +1340,7 @@
                         // termination message. That disconnect is never retransmitted, so
                         // release the peer now instead of waiting for it to come again.
                         Limelog("Server disconnected without a termination reason\n");
+                        hostGoodbye = true;
                         ListenerCallbacks.connectionTerminated(-1);
                         enet_peer_disconnect_now(peer, 0);
                         PltUnlockMutex(&enetMutex);
@@ -1604,6 +1615,9 @@
         }
         else if (event.type == ENET_EVENT_TYPE_DISCONNECT) {
             Limelog("Control stream received unexpected disconnect event\n");
+            // The held disconnect, handed to ENet, ended the peer: the host said goodbye. Without
+            // one this is ENet's timeout.
+            hostGoodbye = disconnectPending;
             ListenerCallbacks.connectionTerminated(-1);
             return;
         }
@@ -1906,10 +1920,12 @@
     if (peer != NULL) {
         // Gracefully disconnect to ensure the remote host receives all of our final
         // outbound traffic, including any key up events that might be sent.
-        if (disconnectPending) {
-            // The intercept held back a disconnect the host has already sent. That host
-            // will never acknowledge ours, so a graceful disconnect would wait out the
-            // whole linger.
+        if (disconnectPending ||
+            (peer->lastReceiveTime != 0 &&
