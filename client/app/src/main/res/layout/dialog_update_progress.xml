<?xml version="1.0" encoding="utf-8"?>
<!-- The update's download, filled in by UpdateFlow: how much has come, over its bar. The label is set as a dialog message is,
     where a message would stand under the title, and the bar keeps the dialog's padding. A bare TextView took the screen's
     default text style, which on the app's screens names only the face, and came out black at the platform's smallest size
     on the night glass (nightjar#7, a Shield). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="@dimen/space_xl" android:paddingEnd="@dimen/space_xl"
    android:paddingTop="@dimen/space_l">
    <TextView android:id="@+id/update_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/update_downloading" android:textAppearance="@style/TextAppearance.Nightjar.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/update_bar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s" android:max="100" android:indeterminate="true" />
</LinearLayout>
