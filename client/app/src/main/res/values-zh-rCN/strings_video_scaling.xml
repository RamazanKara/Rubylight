<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="video_scaling_title">视频大小</string>
    <string-array name="video_scaling_modes">
        <item>适应屏幕</item>
        <item>填充（裁剪）</item>
        <item>拉伸</item>
        <item>1:1 像素</item>
        <item>安全区域适应</item>
    </string-array>
    <string name="video_scaling_help">适应屏幕：显示完整画面，屏幕比例不同时会有黑边。\n填充（裁剪）：在不变形的情况下填满屏幕，超出的边缘会被裁掉。\n拉伸：填满屏幕；画面可能会显得更宽或更高。\n1:1 像素：串流的每个像素对应屏幕上的一个像素。较小的串流四周留边，较大的串流会被裁剪。\n“视频位置”可将适应屏幕或 1:1 的画面移到顶部。双指缩放在所有模式下都可用，画中画始终显示完整画面。
安全区域适应：与“适应屏幕”相同，但会避开摄像头开孔和屏幕圆角。</string>
    <string name="title_video_alignment">视频位置</string>
    <string name="summary_video_alignment">“适应屏幕”或“1:1 像素”画面的位置：居中或顶部。“顶部”会把画面下方的空间空出来。</string>
    <string-array name="video_alignment_names">
        <item>居中</item>
        <item>顶部</item>
    </string-array>
    <string name="picture_position_title">画面位置调整</string>
    <string name="picture_position_horizontal">左 / 右</string>
    <string name="picture_position_vertical">上 / 下</string>
    <string name="picture_position_center">居中</string>
    <string name="summary_picture_position">移动画面以避开摄像头开孔或曲面屏边缘，按本设备的每块屏幕分别保存。除非画面有部分被遮挡，否则保持居中即可。</string>
</resources>
