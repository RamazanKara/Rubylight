+++ b/src/Limelight.h
@@ -941,6 +941,12 @@ const RTP_VIDEO_STATS* LiGetRTPVideoStats(void);
 // parity included: the stream's bandwidth on the wire. Safe to call from any thread.
 uint64_t LiGetWireBytesReceived(void);
 
+// Returns the frames dropped because the decode unit queue overflowed since the stream started: the
+// overflowing frame, the queued frames flushed with it and every whole frame dropped until the IDR
+// frame it requested. They are the decoder's backlog, not network loss; a frame lost or abandoned
+// meanwhile is not counted. Safe to call from any thread.
+uint64_t LiGetDecoderDrops(void);
+
