<?xml version="1.0" encoding="utf-8"?>
<!-- Home on a phone and a handheld: the shelves over the ambient, and the glass chrome floating above them. The tab bar sits
     at the foot on a phone; ConsoleHomeActivity moves it to the top row on a handheld. -->
<com.limelight.ui.GlassHost xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/glass_host"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/home_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipChildren="false" android:clipToPadding="false">
        <com.limelight.ui.BackdropView android:id="@+id/home_backdrop" android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/console_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:clipChildren="false" android:scrollbars="none"
            android:focusable="false" android:descendantFocusability="afterDescendants" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_search_results"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"
            android:clipToPadding="false" android:clipChildren="false" android:scrollbars="none"
            android:focusable="false" android:descendantFocusability="afterDescendants" />
        <TextView android:id="@+id/home_search_none" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="@dimen/space_xl" android:visibility="gone"
            android:text="@string/library_no_matches" android:textAppearance="@style/TextAppearance.Nightjar.Body"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <View android:id="@+id/home_foot_fade" android:layout_width="match_parent" android:layout_height="136dp"
            android:layout_gravity="bottom" android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/console_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal"
            android:padding="@dimen/space_xl" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/console_empty_title"
                android:textAppearance="@style/TextAppearance.Nightjar.ScreenTitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" android:gravity="center" android:text="@string/console_empty_body"
                android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.limelight.ui.GlassButton android:id="@+id/console_empty_hosts" style="@style/Widget.Nightjar.Glass.Play"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/console_empty_open_hosts" app:icon="@drawable/ic_glass_pcs" />
        </LinearLayout>
    </FrameLayout>
    <!-- The screen's title is the selected tab; the toolbar stays for the code that configures it. -->
    <include android:id="@+id/console_toolbar" layout="@layout/view_top_app_bar" android:visibility="gone" />
    <ProgressBar android:id="@+id/console_loading" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" />
    <LinearLayout android:id="@+id/home_top_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false">
        <Space android:id="@+id/home_top_tabs_at" android:layout_width="0dp" android:layout_height="0dp" />
        <Space android:id="@+id/home_top_spacer_start" android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0" />
        <com.limelight.ui.GlassSurface android:id="@+id/home_pc" android:layout_width="wrap_content" android:layout_height="@dimen/glass_capsule"
            android:focusable="true" android:clickable="true" android:defaultFocusHighlightEnabled="false" android:visibility="gone">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="14dp">
                <View android:id="@+id/home_pc_dot" android:layout_width="9dp" android:layout_height="9dp" />
                <TextView android:id="@+id/home_pc_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="9dp" android:layout_marginEnd="6dp" android:maxLines="1" android:ellipsize="end" android:maxWidth="220dp"
                    android:textAppearance="@style/TextAppearance.Nightjar.Glass.Capsule" android:textColor="?attr/colorOnSurface" />
                <ImageView android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_glass_down"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </com.limelight.ui.GlassSurface>
        <Space android:id="@+id/home_top_spacer_end" android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <com.limelight.ui.GlassSurface android:id="@+id/console_view" android:layout_width="@dimen/glass_capsule" android:layout_height="@dimen/glass_capsule"
            android:layout_marginStart="8dp" android:focusable="true" android:clickable="true" android:defaultFocusHighlightEnabled="false"
            android:contentDescription="@string/home_view">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_glass_grid" android:importantForAccessibility="no" />
        </com.limelight.ui.GlassSurface>
        <com.limelight.ui.GlassSurface android:id="@+id/home_search_top" android:layout_width="@dimen/glass_capsule" android:layout_height="@dimen/glass_capsule"
            android:layout_marginStart="8dp" android:visibility="gone" android:focusable="true" android:clickable="true" android:defaultFocusHighlightEnabled="false"
            android:contentDescription="@string/library_search">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_glass_search" android:importantForAccessibility="no" />
        </com.limelight.ui.GlassSurface>
    </LinearLayout>
    <!-- Search on the page: takes the top row's place while it is open. -->
    <com.limelight.ui.GlassSurface android:id="@+id/home_search_bar" android:layout_width="match_parent" android:layout_height="@dimen/glass_capsule"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="6dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_glass_search"
                android:importantForAccessibility="no" />
            <EditText android:id="@+id/home_search_field" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="10dp" android:background="@null" android:hint="@string/library_search"
                android:importantForAutofill="no" android:imeOptions="actionSearch|flagNoExtractUi" android:inputType="text|textNoSuggestions"
                android:maxLines="1" android:textAppearance="@style/TextAppearance.Nightjar.Glass.Capsule"
                android:textColor="?attr/colorOnSurface" android:textColorHint="?attr/colorOnSurfaceVariant" />
            <ImageButton android:id="@+id/home_search_clear" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="fitCenter" android:src="@drawable/ic_close"
                android:contentDescription="@string/library_clear_search" android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.limelight.ui.GlassSurface>
    <!-- The keys of what has focus, for the device in the hand; gone for touch and a mouse. -->
    <TextView android:id="@+id/home_hints" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center" android:paddingStart="8dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:maxLines="1" android:visibility="gone" android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Nightjar.Glass.Hint" android:textColor="?attr/colorOnSurface" />
    <com.google.android.material.button.MaterialButton android:id="@+id/home_pairing_banner"
        style="?attr/nightjarButtonTonalStyle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:maxLines="1" android:ellipsize="end"
        android:visibility="gone" app:icon="@drawable/ic_add" />
    <LinearLayout android:id="@+id/home_bottom_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical"
        android:clipChildren="false" android:clipToPadding="false">
        <com.limelight.ui.GlassSurface android:id="@+id/home_tabs" android:layout_width="0dp" android:layout_height="@dimen/nj_size_tab_bar_height"
            android:layout_weight="1">
            <include layout="@layout/view_shell_bar" android:layout_width="match_parent" android:layout_height="match_parent" />
        </com.limelight.ui.GlassSurface>
        <com.limelight.ui.GlassSurface android:id="@+id/home_search" android:layout_width="@dimen/nj_size_tab_bar_height" android:layout_height="@dimen/nj_size_tab_bar_height"
            android:layout_marginStart="10dp" android:focusable="true" android:clickable="true" android:defaultFocusHighlightEnabled="false"
            android:contentDescription="@string/library_search">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                android:src="@drawable/ic_glass_search" android:importantForAccessibility="no" />
        </com.limelight.ui.GlassSurface>
    </LinearLayout>
</com.limelight.ui.GlassHost>
