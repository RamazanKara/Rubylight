<?xml version="1.0" encoding="utf-8"?>
<!-- Presets on Settings' rail: one line like the sections around it, so Up and Down move one row
     at a time. Wrapping chips made it the rail's tallest row, and the D-pad scrolled inside it instead of reaching Video
     (nightjar#7). Select opens the preset list, which names them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/settings_section_min_height"
    android:gravity="center_vertical" android:paddingStart="@dimen/space_l" android:paddingEnd="@dimen/space_l"
    android:descendantFocusability="blocksDescendants" android:background="@drawable/tv_settings_rail_row">
    <ImageView android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginEnd="@dimen/space_l" android:src="@drawable/ic_speed"
        app:tint="@color/tv_rail_icon" android:duplicateParentState="true" android:importantForAccessibility="no" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:maxLines="1" android:ellipsize="end" android:text="@string/stream_presets"
        android:textAppearance="@style/TextAppearance.Nightjar.Glass.TvRailRow" android:textColor="?attr/colorOnSurface" />
    <TextView android:id="@+id/preset_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
