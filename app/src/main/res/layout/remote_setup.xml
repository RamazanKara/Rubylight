<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/remote_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Nightjar.Title" android:accessibilityHeading="true" />
        <TextView android:id="@+id/remote_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="@style/TextAppearance.Nightjar.Body" />
        <Button android:id="@+id/remote_link" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/remote_get_vpn" />
        <Button android:id="@+id/remote_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/remote_add_address" />
        <Button android:id="@+id/remote_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/remote_test" />
        <TextView android:id="@+id/remote_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textIsSelectable="true" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/remote_previous" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/remote_previous" />
        <Button android:id="@+id/remote_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/remote_next" />
    </LinearLayout>
</ScrollView>
