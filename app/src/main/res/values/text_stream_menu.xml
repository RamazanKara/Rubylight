<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A stream menu tile's label and the quieter line under it (a shortcut's keys), as desktop Nightjar's tiles. -->
    <style name="TextAppearance.Nightjar.Tile" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">14sp</item>
        <item name="android:fontFamily">?attr/nightjarFaceStrong</item>
        <item name="fontFamily">?attr/nightjarFaceStrong</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- The game's name at the head of the stream menu. A TV's is a size up, for the distance. -->
    <style name="TextAppearance.Nightjar.StreamMenuTitle" parent="TextAppearance.Nightjar.Title">
        <item name="android:textSize">@dimen/stream_menu_title</item>
        <item name="lineHeight">@dimen/stream_menu_title_line</item>
    </style>

    <style name="TextAppearance.Nightjar.TileDetail" parent="TextAppearance.Nightjar.Tile">
        <item name="android:textSize">11sp</item>
        <item name="lineHeight">13sp</item>
    </style>
</resources>
