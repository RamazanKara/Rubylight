    <string name="title_list_osc_style">Controller style</string>
    <string name="summary_list_osc_style">Modern ha levette che seguono il pollice e pulsanti frontali che puoi premere due alla volta. Classic mantiene il layout originale; entrambi inviano al PC lo stesso gamepad.</string>
    <string name="osc_style_classic">Classic</string>
    <string name="osc_style_modern">Modern</string>
    <string name="title_list_osc_stick_mode">Modern controller sticks</string>
    <string name="summary_list_osc_stick_mode">Floating centra la levetta dove si posa il pollice, così non devi colpirla con precisione. Scegli Fixed se preferisci puntare alla levetta disegnata.</string>
    <string name="osc_stick_floating">Floating</string>
    <string name="osc_stick_fixed">Fixed</string>
    <string name="title_seekbar_osc_stick_deadzone">Modern controller stick deadzone</string>
    <string name="summary_seekbar_osc_stick_deadzone">Quanto deve muoversi il pollice prima che una levetta risponda. Aumenta il valore se un pollice a riposo sposta la visuale o il personaggio; abbassalo per una mira più fine.</string>
