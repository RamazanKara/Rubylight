<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/LibraryCard"
    android:descendantFocusability="blocksDescendants">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_s">
        <FrameLayout android:layout_width="match_parent" android:layout_height="144dp" android:importantForAccessibility="noHideDescendants">
            <ImageView android:id="@+id/grid_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
            <TextView android:id="@+id/grid_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_xs" android:paddingStart="@dimen/space_s" android:paddingEnd="@dimen/space_s"
                android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs" android:background="@drawable/dialog_background"
                android:textAppearance="@style/TextAppearance.Nightjar.Caption" android:textColor="@color/on_surface" />
        </FrameLayout>
        <TextView android:id="@+id/grid_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" android:paddingStart="@dimen/space_xs" android:paddingEnd="@dimen/space_xs" android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="@color/on_surface"
            android:minLines="2" android:maxLines="2" android:ellipsize="end" android:importantForAccessibility="no" />
        <TextView android:id="@+id/grid_role" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" android:padding="@dimen/space_s" android:maxLines="2" android:ellipsize="end"
            android:background="@drawable/dialog_background" android:drawablePadding="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Nightjar.Caption" android:textColor="@color/on_surface" android:visibility="gone" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/grid_actions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingStart="@dimen/space_xs" android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Nightjar.Label" android:textColor="@color/accent" android:importantForAccessibility="no" />
            <ImageButton android:id="@+id/grid_more" style="@style/ToolbarIcon" android:focusable="false"
                android:importantForAccessibility="yes" android:src="@drawable/ic_library_more" android:contentDescription="@string/library_options" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
