    <string name="pyrowave_missing_features">GPU 不支援 PyroWave</string>
    <string name="pyrowave_missing_formats">GPU 不支援 PyroWave</string>
    <string name="pyrowave_device_limits">GPU 不支援 PyroWave</string>
    <string name="pyrowave_missing_queue">GPU 不支援 PyroWave</string>
    <string name="pyrowave_missing_swapchain">無法使用 Vulkan 顯示</string>
    <string name="pyrowave_missing_hdr">不支援：無法使用 HDR</string>
    <string name="pyrowave_hdr_needs_android_15">HDR 輸出需要 Android 15</string>
    <string name="pyrowave_hdr_display_refused">顯示器或驅動程式拒絕了 HDR 輸出</string>
    <string name="pyrowave_hlg_display_refused">顯示器或驅動程式拒絕了 HLG 輸出</string>
    <string name="pyrowave_check_failed">不支援：GPU 檢查失敗</string>
    <string name="title_enable_hdr">HDR</string>
    <string name="summary_enable_hdr">在 HDR 螢幕上呈現更亮的高光和更豐富的色彩。如果此螢幕能顯示 HDR，且電腦的顯示器已開啟 HDR，請開啟。</string>
    <string name="title_full_range">全範圍色彩</string>
    <string name="summary_full_range">要求全範圍視訊，以保留完整的暗部和高光細節。如果電腦和螢幕沒有都使用全範圍，暗部會死黑或高光會過曝；除非兩者都使用，否則請保持關閉。</string>
    <string name="title_enable_post_stream_toast">串流後顯示解碼時間</string>
    <string name="summary_enable_post_stream_toast">串流結束時顯示平均解碼時間：僅為此裝置的解碼時間，不是端對端延遲。</string>
    <string name="title_rust_engine">新串流引擎</string>
    <string name="summary_rust_engine">用於疑難排解。請保持開啟；僅在串流無法啟動或運作異常時關閉。經典引擎缺少 Frame Warp、「音訊直通」等較新的功能。</string>
    <string name="toast_controller_type_changed">動作控制可能會變更控制器類型。</string>
    <string name="local_network_rationale">請允許存取區域網路，以尋找你的電腦。</string>
