diff --git a/src/ControlStream.c b/src/ControlStream.c
--- a/src/ControlStream.c
+++ b/src/ControlStream.c
@@ -1442,6 +1442,13 @@ static void controlReceiveThreadFunc(void* context) {
                     BridgeClControllerAudio(ctlHdr->type, payload, length);
                 }
             }
