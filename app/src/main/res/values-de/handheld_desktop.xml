    <string name="touch_layout_title">Steuerung für dieses Spiel</string>
    <string name="touch_layout_show">Spieltasten anzeigen</string>
    <string name="touch_layout_hide">Spieltasten ausblenden</string>
    <string name="touch_layout_add">Tastatur- oder Maustaste hinzufügen</string>
    <string name="touch_layout_move">Spieltasten verschieben</string>
    <string name="touch_layout_save">Layout speichern und spielen</string>
    <string name="touch_layout_move_help">Ziehe die Tasten an ihre Position. Die Touch-Eingabe ist beim Verschieben pausiert. Wähle danach hier „Layout speichern und spielen“.</string>
    <string name="touch_layout_import">Layout importieren</string>
    <string name="touch_layout_export">Layout exportieren oder teilen</string>
    <string name="touch_layout_import_help">Füge ein geteiltes JSON-Layout ein. Ersetzen ändert nur dieses Spiel auf diesem PC. Ungültige Layouts lassen deine Tasten unverändert.</string>
    <string name="touch_layout_paste">Layout als JSON einfügen</string>
    <string name="touch_layout_copy">JSON kopieren</string>
    <string name="touch_layout_share">JSON-Datei teilen</string>
    <string name="touch_layout_share_error">Das Layout konnte nicht geteilt werden. Kopiere stattdessen das JSON.</string>
    <string name="touch_layout_limit">Ein Layout kann bis zu 32 Tasten enthalten.</string>
    <string name="touch_layout_name">Tastenname</string>
    <string name="touch_layout_binding">Tasten oder Maustaste</string>
    <string name="touch_layout_binding_help">Beispiele: W, CTRL + C, SPACE. MOUSE_1 ist links, MOUSE_2 Mitte, MOUSE_3 rechts, MOUSE_4 zurück und MOUSE_5 vorwärts.</string>
    <string name="touch_layout_width">Breite (% der Bedienfläche, 4–80)</string>
    <string name="touch_layout_height">Höhe (% der Bedienfläche, 4–80)</string>
    <string name="touch_layout_toggle">Antippen zum Halten; erneut tippen zum Loslassen</string>
    <string name="touch_layout_hold">Halten, solange gedrückt</string>
    <string name="touch_layout_pressed">Gehalten</string>
    <string name="touch_layout_released">Losgelassen</string>
    <string name="touch_layout_invalid">Prüfe Name, unterstützte Belegung und Größe (4–80 %). Importierte Layouts müssen Version 1, höchstens 32 Tasten und 64 KiB haben.</string>
    <string name="desktop_title">Desktop und Anzeige</string>
    <string name="desktop_zoom_enable">Zoom und Verschieben aktivieren</string>
    <string name="desktop_zoom_disable">Zoom und Verschieben deaktivieren</string>
    <string name="desktop_zoom_reset">Zoom zurücksetzen</string>
    <string name="desktop_zoom_help">Mit zwei Fingern bis zu 4× zoomen und verschieben. Ein Finger verwendet weiterhin den gewählten Touchmodus. Scrollen mit zwei Fingern ist dabei ersetzt.</string>
    <string name="desktop_zoom_surface_help">Aktiviere unter Android 5 und 6 TextureView in den Stream-Einstellungen und verbinde dich erneut, um zu zoomen.</string>
    <string name="desktop_output">Videoausgabe (verbindet Stream neu)</string>
    <string name="desktop_output_device">Dieses Gerät</string>
    <string name="desktop_touchpad_help">Das Video läuft auf der externen Anzeige. Nutze diesen Bildschirm als Touchpad. Tastatur, Spieltasten und Stream-Menü bleiben hier verfügbar.</string>
    <string name="desktop_pacing_fallback">Externes Video nutzt für diese Sitzung geringste Latenz statt ausgewogenem Frame-Pacing. Deine gespeicherte Einstellung bleibt unverändert.</string>
    <string name="desktop_display_unavailable">Keine nutzbare externe Anzeige verfügbar. Verbinde eine von Android unterstützte HDMI-/USB-C- oder drahtlose Anzeige. Das Video bleibt auf diesem Gerät.</string>
