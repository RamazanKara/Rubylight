<com.limelight.ui.ContentFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include android:id="@+id/settings_toolbar" layout="@layout/view_top_app_bar" />
        <androidx.appcompat.widget.SearchView android:id="@+id/settings_search"
            android:nextFocusDown="@android:id/list" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
            android:background="@drawable/settings_search_background"
            app:queryBackground="@android:color/transparent" app:submitBackground="@android:color/transparent"
            app:iconifiedByDefault="false" />
        <TextView android:id="@+id/settings_context"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/on_surface_variant"
            android:accessibilityLiveRegion="polite" />
        <FrameLayout android:id="@+id/stream_settings"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</com.limelight.ui.ContentFrame>
