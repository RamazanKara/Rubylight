<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Nightjar palette: blue-black night surfaces and the amber of the brand moon, from the design tokens
        (design_tokens.xml) where a token exists.
        Amber marks primary actions and selection only. The themes read these through the role aliases
        in colors.xml, except Theme.Nightjar.Stream, which always uses the night set.
        Contrast (WCAG): night primary on surface 9.0:1, dark text on amber 8.6:1, on-surface 14.3:1,
        on-surface-variant 10.4:1; day bronze primary on surface 6.1:1 (5.2:1 on dialogs), white on bronze 6.4:1,
        on-surface 16.2:1, on-surface-variant 8.7:1. Outlines clear 3:1 on their surfaces.
    -->

    <!-- Night (default) -->
    <color name="night_primary">@color/nj_color_moon</color>
    <color name="night_on_primary">@color/nj_color_on_moon</color>
    <color name="night_primary_container">#5C3E00</color>
    <color name="night_on_primary_container">#FFDDB0</color>
    <color name="night_inverse_primary">#845500</color>
    <color name="night_secondary">#C2C6D6</color>
    <color name="night_on_secondary">#2B303F</color>
    <color name="night_secondary_container">#343A4B</color>
    <color name="night_on_secondary_container">#DEE2F3</color>
    <color name="night_tertiary">#AFC8E9</color>
    <color name="night_on_tertiary">#18304B</color>
    <color name="night_tertiary_container">#304763</color>
    <color name="night_on_tertiary_container">#D2E4FF</color>
    <color name="night_error">@color/nj_color_error</color>
    <color name="night_on_error">#690005</color>
    <color name="night_error_container">@color/nj_color_danger_fill</color>
    <color name="night_on_error_container">@color/nj_color_on_danger_fill</color>
    <color name="night_surface">@color/nj_color_night</color>
    <color name="night_surface_dim">@color/nj_color_night</color>
    <color name="night_surface_bright">@color/nj_color_surface_bright</color>
    <color name="night_surface_container_lowest">@color/nj_color_surface_lowest</color>
    <color name="night_surface_container_low">@color/nj_color_surface_low</color>
    <color name="night_surface_container">@color/nj_color_surface</color>
    <color name="night_surface_container_high">@color/nj_color_surface_high</color>
    <color name="night_surface_container_highest">@color/nj_color_surface_highest</color>
    <color name="night_on_surface">@color/nj_color_label</color>
    <color name="night_on_surface_variant">@color/nj_color_label_secondary</color>
    <color name="night_outline">#8B8E9C</color>
    <color name="night_outline_variant">#3F4250</color>
    <color name="night_inverse_surface">@color/nj_color_label</color>
    <color name="night_inverse_on_surface">#2B2D38</color>
    <!-- Status roles shared with the Rubylight console (ok = live or ready, warn = a problem worth a look).
         Warn is never a filled shape: it is an icon plus a word, or text on its container, so it never reads
         as the amber action colour. -->
    <color name="night_status_ok">@color/nj_color_ok</color>
    <color name="night_status_ok_container">#0F3A22</color>
    <color name="night_on_status_ok_container">#A6F2C2</color>
    <color name="night_status_warn">@color/nj_color_warn</color>
    <color name="night_status_warn_container">#3D2F00</color>
    <color name="night_on_status_warn_container">#FFE69C</color>

    <!-- Day -->
    <color name="day_primary">@color/nj_day_color_moon_ink</color>
    <color name="day_on_primary">#FFFFFF</color>
    <color name="day_primary_container">#FFDDB3</color>
    <color name="day_on_primary_container">#2A1800</color>
    <color name="day_inverse_primary">@color/brand_moon</color>
    <color name="day_secondary">#565E71</color>
    <color name="day_on_secondary">#FFFFFF</color>
    <color name="day_secondary_container">#DDE2F4</color>
    <color name="day_on_secondary_container">#141B2C</color>
    <color name="day_tertiary">#3F5F80</color>
    <color name="day_on_tertiary">#FFFFFF</color>
    <color name="day_tertiary_container">#D2E4FF</color>
    <color name="day_on_tertiary_container">#001D36</color>
    <color name="day_error">@color/nj_day_color_error</color>
    <color name="day_on_error">#FFFFFF</color>
    <color name="day_error_container">#FFDAD6</color>
    <color name="day_on_error_container">#410002</color>
    <color name="day_surface">@color/nj_day_color_canvas</color>
    <color name="day_surface_dim">#D8D9DF</color>
    <color name="day_surface_bright">@color/nj_day_color_canvas</color>
    <color name="day_surface_container_lowest">#FFFFFF</color>
    <color name="day_surface_container_low">#F2F3F8</color>
    <color name="day_surface_container">#ECEDF2</color>
    <color name="day_surface_container_high">#E6E7EC</color>
    <color name="day_surface_container_highest">#E1E2E8</color>
    <color name="day_on_surface">@color/nj_day_color_label</color>
    <color name="day_on_surface_variant">@color/nj_day_color_label_secondary</color>
    <color name="day_outline">#757887</color>
    <color name="day_outline_variant">#C5C7D3</color>
    <color name="day_inverse_surface">#2F3037</color>
    <color name="day_inverse_on_surface">#F0F0F7</color>
    <color name="day_status_ok">@color/nj_day_color_ok</color>
    <color name="day_status_ok_container">#C4EFD2</color>
    <color name="day_on_status_ok_container">#00210E</color>
    <color name="day_status_warn">@color/nj_day_color_warn</color>
    <color name="day_status_warn_container">#FFE7A3</color>
    <color name="day_on_status_warn_container">#231A00</color>

    <!-- Fixed roles keep the same tone in both themes. -->
    <color name="primary_fixed">#FFDDB3</color>
    <color name="primary_fixed_dim">@color/brand_moon</color>
    <color name="on_primary_fixed">#2A1800</color>
    <color name="on_primary_fixed_variant">#643F00</color>
    <color name="secondary_fixed">#DDE2F4</color>
    <color name="secondary_fixed_dim">#C2C6D6</color>
    <color name="on_secondary_fixed">#141B2C</color>
    <color name="on_secondary_fixed_variant">#3F4759</color>
    <color name="tertiary_fixed">#D2E4FF</color>
    <color name="tertiary_fixed_dim">#AFC8E9</color>
    <color name="on_tertiary_fixed">#001D36</color>
    <color name="on_tertiary_fixed_variant">#2D4865</color>
</resources>
