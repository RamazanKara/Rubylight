<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="stream_touch_off_help">タッチはオフです。戻るジェスチャーまたは戻るボタンでストリームメニューを開きます。</string>
    <string name="title_local_cursor_speed">ローカルカーソルの速度</string>
    <string name="title_trackpad_acceleration">ポインタの加速</string>
    <string name="summary_trackpad_acceleration">指をゆっくり動かすとポインタの動きが小さくなって細かく狙え、速くスワイプすると遠くまで動きます。タッチモード「トラックパッド」と「ローカルカーソル」で使われ、次回のストリームから適用されます。</string>
    <string name="title_trackpad_acceleration_curve">加速の強さ</string>
    <string-array name="trackpad_acceleration_curve_names">
        <item>弱</item>
        <item>中</item>
        <item>強</item>
    </string-array>
    <string name="title_trackpad_momentum">フリック後の慣性</string>
    <string name="summary_trackpad_momentum">素早くフリックした後もポインタが動き続け、徐々に遅くなります。画面に触れるとすぐに止まります。タッチモード「トラックパッド」と「ローカルカーソル」で使われます。</string>
    <string name="title_trackpad_momentum_glide">慣性の距離</string>
    <string-array name="trackpad_momentum_glide_names">
        <item>短い</item>
        <item>中</item>
        <item>長い</item>
    </string-array>
    <string name="title_trackpad_area">トラックパッドの範囲</string>
    <string name="summary_trackpad_area">「トラックパッド」と「ローカルカーソル」のジェスチャーを開始できる画面の範囲です。範囲外から始めたタッチは無視されます。半分を選ぶと、反対側に親指を置いておけます。</string>
    <string-array name="trackpad_area_names">
        <item>画面全体</item>
        <item>右半分</item>
        <item>左半分</item>
        <item>下半分</item>
        <item>上半分</item>
    </string-array>
    <string name="title_three_finger_tap">3 本指タップ</string>
    <string name="summary_three_finger_tap">3 本指で素早くタップしたときの動作です。「システムキーボード」は Android のキーボード、「PCキーボード」は F キー、Ctrl、Win を備えたキーボード、「キーボードとマウス」はキーとトラックパッドのパネルです。</string>
    <string-array name="three_finger_tap_names">
        <item>@string/desktop_controls_system_keyboard</item>
        <item>中クリック</item>
        <item>@string/desktop_controls_open</item>
        <item>@string/stream_disabled</item>
        <item>@string/pc_keyboard_title</item>
    </string-array>
    <string name="stream_cursor_shape_rejected">Nightjar は PC のカーソル形状を描画できないため、標準の矢印を表示します。</string>
    <string name="title_four_finger_tap">4本指タップ</string>
    <string name="summary_four_finger_tap">4 本指で素早くタップしたときの動作です。「システムキーボード」は Android のキーボード、「PCキーボード」は F キー、Ctrl、Win を備えたキーボード、「キーボードとマウス」はキーとトラックパッドのパネルです。</string>
    <string name="title_multi_touch_finger_taps">マルチタッチでの複数本指タップ</string>
    <string name="summary_multi_touch_finger_taps">「マルチタッチ」モードでも、3 本指と 4 本指のタップで設定した動作を実行します。これらのタップはタッチとして PC に届かなくなります。PC 側でこれらのタップを使う場合はオフのままにしてください。</string>
</resources>
