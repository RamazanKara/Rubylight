+static bool same_plane(const pyrowave_image_view &a, const pyrowave_image_view &b)
+{
+	return a.image == b.image && a.width == b.width && a.height == b.height &&
+	       a.image_format == b.image_format && a.view_format == b.view_format &&
+	       a.mip_level == b.mip_level && a.layer == b.layer && a.aspect == b.aspect &&
+	       a.swizzle == b.swizzle && a.layout == b.layout;
+}
+
+// The encoder's plane views, wrapped when the caller first passes these planes
+// and reused while it passes the same planes of the same live pyrowave_images.
+// Returns false for planes of images pyrowave_image_create did not make: the
+// device cannot see when those are destroyed, so a new image could reuse a
+// cached VkImage handle. The caller wraps those for this frame only.
+static bool cached_plane_views(pyrowave_encoder encoder, const pyrowave_gpu_buffers *buffers,
+                               ViewBuffers &views)
+{
+	uint64_t ids[3];
+	{
+		auto *pyro_device = encoder->pyro_device;
+		std::lock_guard<std::mutex> holder{pyro_device->image_lock};
+		for (int i = 0; i < 3; i++)
+		{
+			auto itr = pyro_device->image_ids.find(buffers->planes[i].image);
+			if (itr == pyro_device->image_ids.end())
+				return false;
+			ids[i] = itr->second;
+		}
+	}
+
+	bool same = true;
+	for (int i = 0; same && i < 3; i++)
+	{
+		same = bool(encoder->plane_views[i]) && encoder->plane_ids[i] == ids[i] &&
+		       same_plane(encoder->plane_keys[i], buffers->planes[i]);
+	}
+
+	if (!same)
+	{
+		WrappedViewBuffers fresh = {};
+		if (!fresh.wrap(encoder->device, buffers, VK_IMAGE_USAGE_SAMPLED_BIT))
+			return false;
+		for (int i = 0; i < 3; i++)
+		{
+			// Views before the images they were made from, as WrappedViewBuffers
+			// releases them.
+			encoder->plane_views[i] = std::move(fresh.image_views[i]);
+			encoder->plane_images[i] = std::move(fresh.wrapped_images[i]);
+			encoder->plane_keys[i] = buffers->planes[i];
+			encoder->plane_ids[i] = ids[i];
+		}
+	}
+
+	for (int i = 0; i < 3; i++)
+		views.planes[i] = encoder->plane_views[i].get();
+	return true;
+}
