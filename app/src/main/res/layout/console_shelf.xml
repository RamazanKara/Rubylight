<?xml version="1.0" encoding="utf-8"?>
<!-- One shelf of Home: a heading with its count and a chevron over a row of cards. ConsoleHomeAdapter fills it; the cards
     scroll sideways on their own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:clipChildren="false" android:clipToPadding="false">
    <LinearLayout android:id="@+id/shelf_head" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp"
        android:paddingStart="16dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/shelf_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Nightjar.Glass.Section" android:textColor="?attr/colorOnSurface"
            android:accessibilityHeading="true" />
        <TextView android:id="@+id/shelf_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textAppearance="@style/TextAppearance.Nightjar.Body"
            android:textColor="?attr/colorOnSurfaceVariant" android:importantForAccessibility="no" />
        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <ImageView android:id="@+id/shelf_more" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_glass_right" android:visibility="gone" android:importantForAccessibility="no" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/shelf_cards"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never"
        android:paddingStart="8dp" android:paddingEnd="@dimen/shelf_keyline" android:focusable="false"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
