<com.limelight.ui.ContentFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/host_profile_toolbar"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
            app:title="@string/host_profile_menu" app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationContentDescription="@string/settings_navigate_up" />
        <TextView android:id="@+id/host_profile_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="8dp"
            android:maxLines="2" android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/accent" />
        <FrameLayout android:id="@+id/host_profile_settings" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/host_profile_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp"
            android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/on_surface_variant"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/host_profile_save"
            android:nextFocusUp="@android:id/list" android:accessibilityTraversalAfter="@android:id/list"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp"
            android:minHeight="48dp" android:text="@string/host_profile_save" />
    </LinearLayout>
</com.limelight.ui.ContentFrame>
