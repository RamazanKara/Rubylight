<resources>
    <string name="title_network_grace">Wait through network dropouts</string>
    <string name="summary_network_grace">How long a silent network is waited out before the stream ends; the picture freezes meanwhile. Raise it if short dropouts end your streams; the PC must wait as long too.</string>
    <string name="network_grace_off">Off (10 seconds)</string>
    <string name="network_grace_15">15 seconds</string>
    <string name="network_grace_20">20 seconds</string>
    <string name="network_grace_30">30 seconds</string>
    <string name="network_grace_60">60 seconds</string>
    <string name="network_grace_gave_up">The connection stayed silent for longer than the %1$d-second drop tolerance, or the PC ended the session. If the PC gave up first, raise its own client timeout as well.</string>
    <string-array name="network_grace_names"><item>@string/network_grace_off</item><item>@string/network_grace_15</item><item>@string/network_grace_20</item><item>@string/network_grace_30</item><item>@string/network_grace_60</item></string-array>
    <string-array name="network_grace_values" translatable="false"><item>0</item><item>15</item><item>20</item><item>30</item><item>60</item></string-array>
</resources>
