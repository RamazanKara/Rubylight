<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The stream menu's compact grid on a handheld or tablet, as desktop Nightjar's: a 20dp icon over a 12sp label, up
         to six tiles to a row while each stays wide enough for its label, a slim Return to stream bar and the ways out
         in a slim row under it. A TV has its own, for the distance (values-television). -->
    <integer name="stream_tile_columns">6</integer>
    <dimen name="stream_tile_min_width">70dp</dimen>
    <dimen name="stream_tile_min_height">58dp</dimen>
    <dimen name="stream_tile_gap">6dp</dimen>
    <dimen name="stream_tile_icon">20dp</dimen>
    <dimen name="stream_tile_icon_gap">2dp</dimen>
    <dimen name="stream_tile_pad_top">6dp</dimen>
    <dimen name="stream_tile_pad_bottom">5dp</dimen>
    <dimen name="stream_tile_pad_side">4dp</dimen>
    <dimen name="stream_tile_corner">10dp</dimen>
    <dimen name="stream_tile_cap_text">9sp</dimen>
    <dimen name="stream_tile_switch_width">18dp</dimen>
    <dimen name="stream_tile_switch_height">10dp</dimen>
    <dimen name="stream_tile_corner_inset">5dp</dimen>
    <dimen name="stream_menu_return_height">38dp</dimen>
    <dimen name="stream_menu_exit_height">34dp</dimen>
    <dimen name="stream_menu_footer_icon">18dp</dimen>
    <dimen name="stream_menu_edge">16dp</dimen>
</resources>
