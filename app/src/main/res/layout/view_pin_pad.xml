<?xml version="1.0" encoding="utf-8"?>
<!-- The PIN pad shared by the portrait and landscape layouts. Labels are set in code; a remote or a pad moves over its keys. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pin_pad"
    android:layout_width="@dimen/pin_pad_width" android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_1"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_2"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_3"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_4"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_5"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_6"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_7"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_8"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_9"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_ok"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp"
            android:contentDescription="@string/pin_key_confirm" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_0"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_key_del"
            style="?attr/nightjarPinKeyStyle"
            android:layout_width="0dp" android:layout_height="@dimen/pin_key_height" android:layout_weight="1"
            android:layout_margin="@dimen/space_xs" android:insetTop="0dp" android:insetBottom="0dp"
            android:padding="0dp"
            android:contentDescription="@string/pin_key_delete" />
    </LinearLayout>
</LinearLayout>
