<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        What High contrast and Reduce motion change, as theme attributes, so layouts and drawables stay the same
        and AppTheme.apply only layers ThemeOverlay.Nightjar.HighContrast and ThemeOverlay.Nightjar.ReducedMotion.
    -->
    <!-- Stroke of the focus ring on rows, shell items and icon buttons. -->
    <attr name="nightjarFocusRingWidth" format="dimension" />
    <!-- Stroke of the focus ring on cards and grid items. -->
    <attr name="nightjarCardFocusRingWidth" format="dimension" />
    <!-- Colour of a tonal button's outline at rest: none normally, the on-surface colour in high contrast. -->
    <attr name="nightjarButtonRestStroke" format="color|reference" />
    <!-- Stroke of an unfocused card. -->
    <attr name="nightjarCardStrokeWidth" format="dimension" />
    <!-- Focus animators (res/animator): full, still, thick and thick-still versions. -->
    <attr name="nightjarCardFocusAnimator" format="reference" />
    <attr name="nightjarControlFocusAnimator" format="reference" />
    <!-- A TV library poster: its focus tween (large and small), its ring and its glow. High contrast thickens the
         ring and drops the glow; Reduce motion stops the zoom and the fades. -->
    <attr name="nightjarPosterFocusAnimator" format="reference" />
    <attr name="nightjarPosterRing" format="reference" />
    <attr name="nightjarPosterGlow" format="reference" />
    <!-- The interface's two weights: a font resource where Figtree covers the language, else the system face. -->
    <attr name="nightjarFace" format="string|reference" />
    <attr name="nightjarFaceStrong" format="string|reference" />
    <declare-styleable name="GlassSurface">
        <!-- A recipe of the design tokens: chrome, panel, menu or chip. -->
        <attr name="glassMaterial" format="string" />
        <!-- Corner radius; left out, the shape is a capsule. -->
        <attr name="glassRadius" format="dimension" />
    </declare-styleable>
    <declare-styleable name="GlassButton">
        <!-- Solid moon, for Play. -->
        <attr name="glassMoon" format="boolean" />
        <!-- Words alone, for a link. -->
        <attr name="glassLink" format="boolean" />
    </declare-styleable>
    <!-- The glass colours that differ between the looks. The themes point them at the design tokens. -->
    <declare-styleable name="OrbitView">
        <!-- Draws the moon and the bird in the middle, for a page with nothing of its own to put there. -->
        <attr name="orbitMoon" format="boolean" />
        <attr name="orbitRingsStart" format="float" />
    </declare-styleable>
    <attr name="glassCanvas" format="color" />
    <attr name="glassPlaceholder" format="color" />
    <attr name="glassSelectedFill" format="color" />
    <attr name="glassSelectedRim" format="color" />
    <attr name="glassOnSelected" format="color" />
    <attr name="glassControlFill" format="color" />
    <attr name="glassControlRim" format="color" />
    <attr name="glassGroupOnArt" format="color" />
    <attr name="glassGroupRim" format="color" />
    <attr name="glassSeparator" format="color" />
    <attr name="glassRing" format="color" />
    <attr name="glassRingOnMoon" format="color" />
    <attr name="glassGap" format="color" />
    <attr name="glassHalo" format="color" />
    <attr name="glassOk" format="color" />
</resources>
