    <string name="title_resolution_list">解析度</string>
    <string name="summary_resolution_list">電腦傳送的畫面大小。越高越清晰，對網路和解碼效能的需求也越高；串流卡頓時請調低。</string>
    <string name="title_fps_list">影格速率</string>
    <string name="summary_fps_list">每秒影格數（FPS）。越高越流暢，也需要更快的網路和更強的解碼效能；串流卡頓時請調低。</string>
    <string name="title_seekbar_bitrate">位元速率</string>
    <string name="suffix_seekbar_bitrate_mbps">Mbps</string>
    <string name="dialog_seekbar_bitrate">每秒的視訊資料量。越高越清晰，也需要更快的網路；畫面卡頓或破圖時請調低。</string>
    <string name="seekbar_decrease">減少</string>
    <string name="seekbar_increase">增加</string>
    <string name="seekbar_presets">預設組合</string>
    <string name="seekbar_presets_unit">預設組合 (%1$s)</string>
    <string name="fps_suffix_fps">FPS</string>
    <string name="title_audio_config_list">聲道</string>
    <string name="summary_audio_config_list">立體聲，或 5.1、7.1 或 7.1.4 環繞音效。使用耳機或兩支喇叭時請選「立體聲」；只有喇叭和電腦都已設定好環繞音效時，才選環繞音效。</string>
    <string name="title_checkbox_enable_audiofx">允許系統音效</string>
    <string name="summary_checkbox_enable_audiofx">讓 Android 等化器和音效處理聲音。可能增加音訊延遲；除非你使用這類音效，否則請保持關閉。</string>
    <string name="category_gamepad_settings">控制器</string>
    <string name="summary_checkbox_multi_controller">開啟：每個控制器各為一位玩家，且只有在控制器連接時電腦才會偵測到。關閉：所有控制器都作為玩家 1，且電腦一律會偵測到一個控制器。</string>
    <string name="title_checkbox_vibrate_fallback">以裝置震動模擬控制器震動</string>
    <string name="summary_checkbox_vibrate_fallback">控制器沒有震動馬達時，由此裝置震動來代替玩家 1 的控制器震動。如果你玩的時候手持此裝置，請開啟。</string>
    <string name="title_seekbar_vibrate_fallback_strength">裝置震動強度</string>
    <string name="summary_seekbar_vibrate_fallback_strength">這部裝置震動的強度。</string>
    <string name="suffix_seekbar_vibrate_fallback_strength">%</string>
    <string name="title_seekbar_deadzone">搖桿死區</string>
    <string name="summary_seekbar_deadzone">忽略搖桿在中心附近的小幅移動。搖桿放開後仍會飄移時調高；想讓小幅移動也有反應時調低。遊戲可能還會加上自己的死區。</string>
    <string name="suffix_seekbar_deadzone">%</string>
    <string name="title_seekbar_trigger_deadzone">扳機死區</string>
    <string name="summary_seekbar_trigger_deadzone" formatted="false">忽略輕微的扳機按壓。扳機放開後仍被判定為按下時調高；想讓輕按也有反應時調低。遊戲可能還會加上自己的死區。</string>
    <string name="title_checkbox_xb1_driver">USB 控制器驅動程式</string>
    <string name="summary_checkbox_xb1_driver">Nightjar 內建的驅動程式，適用於透過 USB 連接的 Xbox 控制器，在 Android 本身不支援它們時使用。請保持開啟；需要時 Android 會要求 USB 存取權。</string>
    <string name="title_usb_dualsense_haptics">USB DualSense 音訊和觸覺回饋</string>
    <string name="summary_usb_dualsense_haptics">有線 DualSense 可播放遊戲的觸覺回饋（波形震動），其喇叭、耳機和麥克風可與電腦搭配使用。需要電腦支援這些功能。</string>
    <string name="title_usb_dualsense">USB DualSense 驅動程式</string>
    <string name="summary_usb_dualsense">Nightjar 自行透過 USB 讀取 DualSense，讓遊戲可以使用自適應扳機、震動和燈條。串流時 Android 會要求 USB 存取權；藍牙連線仍使用 Android 的輸入。</string>
    <string name="usb_dualsense_permission_info">開始串流時請允許 USB 存取權。\n否則自適應扳機會保持關閉。</string>
    <string name="usb_dualsense_enable">啟用 USB 驅動程式</string>
    <string name="usb_dualsense_denied">沒有 USB 存取權；自適應扳機已關閉。\n請重新連接傳輸線以重試。</string>
    <string name="title_checkbox_usb_bind_all">一律使用 USB 驅動程式</string>
    <string name="summary_checkbox_usb_bind_all">即使是 Android 支援的 Xbox 控制器，也使用 Nightjar 的驅動程式。如果 USB 控制器透過 Android 沒有震動，請開啟，然後重新連接控制器。</string>
    <string name="title_checkbox_mouse_emulation">控制器滑鼠模式</string>
    <string name="summary_checkbox_mouse_emulation">按住 Start 可讓控制器在控制器模式和滑鼠模式之間切換。如果在遊戲中會誤觸，請關閉；串流選單中的「滑鼠」圖塊仍可切換。</string>
    <string name="title_checkbox_flip_face_buttons">任天堂按鈕配置</string>
    <string name="summary_checkbox_flip_face_buttons">交換 A 與 B、X 與 Y。如果希望 Nintendo 式控制器的按鈕傳送印在上面的字母，請開啟。</string>
    <string name="title_checkbox_gamepad_touchpad_as_mouse">控制器觸控板作為滑鼠</string>
    <string name="summary_checkbox_gamepad_touchpad_as_mouse">控制器的觸控板（DualSense 等）像滑鼠一樣移動電腦的指標。遊戲將不再收到它的觸控；玩會用到觸控板的遊戲時請保持關閉。</string>
    <string name="title_checkbox_gamepad_motion_sensors">體感控制</string>
    <string name="summary_checkbox_gamepad_motion_sensors">將控制器的陀螺儀和加速度計資料傳送給遊戲，用於體感瞄準。電腦可能因此把它當作 PlayStation 控制器；如果遊戲顯示的按鈕圖示不對，請關閉。</string>
    <string name="title_checkbox_gamepad_motion_fallback">使用裝置動作感應器</string>
    <string name="summary_checkbox_gamepad_motion_fallback">控制器沒有陀螺儀和加速度計時，玩家 1 改用此裝置的感應器，移動裝置即可進行體感操作。電腦可能因此把該控制器當作 PlayStation 控制器。</string>
    <string name="category_input_settings">觸控與滑鼠</string>
    <string name="title_trackpad_speed">觸控板速度</string>
    <string name="title_mouse_speed">滑鼠速度</string>
    <string name="title_trackpad_sensitivity_x">觸控板靈敏度 X</string>
    <string name="summary_trackpad_sensitivity_x">實體觸控板（例如鍵盤保護套上的）的水平指標速度，疊加在「滑鼠速度」之上。負值會反轉方向；觸控模式使用「觸控板速度」。</string>
    <string name="title_trackpad_sensitivity_y">觸控板靈敏度 Y</string>
    <string name="summary_trackpad_sensitivity_y">實體觸控板（例如鍵盤保護套上的）的垂直指標速度，疊加在「滑鼠速度」之上。負值會反轉方向；觸控模式使用「觸控板速度」。</string>
    <string name="title_trackpad_scroll_speed">觸控板捲動速度</string>
    <string name="summary_trackpad_scroll_speed">在實體觸控板上以及在「觸控板（觸控板手勢）」觸控模式下，雙指捲動的幅度。捲動太靈敏時請調低。</string>
    <string name="title_trackpad_swap_axis">交換觸控板 X 和 Y</string>
    <string name="summary_trackpad_swap_axis">交換實體觸控板的 X 軸和 Y 軸。僅在上下滑動時指標卻橫向移動的情況下開啟；觸控模式不受影響。</string>
    <string name="title_native_touchpad">在電腦上使用觸控板手勢</string>
    <string name="summary_native_touchpad">將實體觸控板上的手指動作傳送到電腦，讓電腦本身的手勢在那裡運作：雙指捲動、三指和四指滑動。無法接收的電腦仍像以前一樣收到指標移動。</string>
    <string name="stream_native_touchpad_fallback">此串流不接受觸控板手指，因此觸控板會移動滑鼠。</string>
    <string name="title_checkbox_absolute_mouse_mode">滑鼠模式</string>
    <string name="summary_checkbox_absolute_mouse_mode">「擷取」讓指標留在串流中並傳送相對移動，用滑鼠轉動視角的遊戲需要這種方式。「桌面指標」像一般滑鼠一樣移動，適合桌面操作。</string>
    <string name="title_checkbox_mouse_nav_buttons">滑鼠上一頁/下一頁按鈕</string>
    <string name="summary_checkbox_mouse_nav_buttons">將滑鼠的上一頁和下一頁按鈕傳送到電腦。如果右鍵因此失效，請保持關閉：有些裝置會把右鍵回報為上一頁。</string>
    <string name="category_on_screen_controls_settings">螢幕控制按鈕</string>
    <string name="title_checkbox_show_onscreen_controls">顯示螢幕控制按鈕</string>
    <string name="title_checkbox_vibrate_osc">按下時震動</string>
    <string name="title_only_l3r3">僅顯示 L3 和 R3</string>
    <string name="summary_only_l3r3">隱藏 L3 和 R3（按下搖桿）以外的所有螢幕按鈕。僅在你的控制器只缺按下搖桿的功能時開啟。</string>
    <string name="title_show_guide_button">顯示 Guide 按鈕</string>
    <string name="title_show_touchpad_button">顯示觸控板按鈕</string>
    <string name="summary_show_touchpad_button">加入一個用來按下 PlayStation 控制器觸控板的按鈕。玩家 1 會因此以 PlayStation 控制器的身分連線到電腦；除非遊戲需要這個按鈕，否則請保持關閉。</string>
    <string name="title_osc_steam_controls">Steam Controller 控制項</string>
    <string name="summary_osc_steam_controls">為螢幕控制項加入觸控板、背鍵（L4、R4、L5、R5）和握把觸碰。僅適用於控制器類型為 Steam Controller 的電腦；設為「自動」時，電腦可能選用 PlayStation 控制器。</string>
    <string name="title_reset_osc">重設控制按鈕版面配置</string>
    <string name="dialog_title_reset_osc">重設版面配置</string>
    <string name="dialog_text_reset_osc">要將所有螢幕按鈕恢復為預設大小和位置嗎？為單一遊戲儲存的配置也會一併重設。</string>
    <string name="toast_reset_osc_success">已將螢幕控制按鈕重設為預設值</string>
    <string name="title_osc_opacity">不透明度</string>
    <string name="summary_osc_opacity">螢幕控制按鈕的可見程度。調低可看到更多被它們遮住的遊戲畫面。</string>
    <string name="suffix_osc_opacity">%</string>
    <string name="title_checkbox_enable_pip">子母畫面</string>
    <string name="summary_checkbox_enable_pip">離開應用程式時，串流會保留在小視窗中，螢幕控制按鈕和覆蓋層會隱藏。關閉後，離開應用程式時串流會停止。</string>
    <string name="title_language_list">語言</string>
    <string name="title_checkbox_small_icon_mode">使用小型封面圖</string>
    <string name="summary_checkbox_small_icon_mode">在電腦的遊戲庫中，一個畫面可顯示更多遊戲。</string>
    <string name="title_quick_resume">快速繼續</string>
    <string name="summary_quick_resume">選擇正在執行遊戲的電腦會直接回到該遊戲，略過遊戲庫。開啟期間，可從電腦的選單開啟遊戲庫。</string>
    <string name="title_checkbox_enable_sops">遊戲最佳化提示</string>
    <string name="summary_checkbox_enable_sops">允許電腦為串流調整遊戲設定。請保持開啟；如果電腦變更了遊戲的設定而你想保留原本的設定，請關閉。</string>
    <string name="title_checkbox_host_audio">同時在電腦上播放音訊</string>
    <string name="title_unlock_fps">顯示所有影格速率</string>
    <string name="title_checkbox_reduce_refresh_rate">允許較低的更新率</string>
    <string name="summary_checkbox_reduce_refresh_rate">允許螢幕使用仍能配合串流的最低更新率（例如 60 FPS 使用 60 Hz），以節省電力。關閉則維持最高更新率，延遲更低。</string>
    <string name="title_checkbox_disable_warnings">隱藏連線警告</string>
    <string name="summary_checkbox_disable_warnings">串流期間不顯示連線品質不佳的警告。連線已調整好、不再需要這些警告時，可以開啟。</string>
    <string name="title_video_format">視訊轉碼器</string>
    <string name="summary_video_format">視訊的壓縮方式。請保持「自動」，除非畫面停頓或破圖；這時再試試 H.264，它是相容性最高的轉碼器。</string>
    <string name="pyrowave_ready">這支手機已可使用。需要電腦支援。</string>
    <string name="pyrowave_checking">正在檢查 GPU 支援…</string>
    <string name="pyrowave_needs_android">不支援：需要 Android 10</string>
    <string name="pyrowave_needs_64_bit">不支援：需要 64 位元應用程式</string>
    <string name="pyrowave_decoder_unavailable">不支援：無法使用解碼器</string>
    <string name="pyrowave_needs_vulkan">不支援：需要 Vulkan 1.1</string>
