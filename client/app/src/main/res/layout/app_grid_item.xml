<?xml version="1.0" encoding="utf-8"?>
<!-- A game in a PC's grid: a 2:3 cover, or its no-art tile, and no label; the title is on the art and in the card's description.
     The dot says it is running, and a chip what a remote role does. AppGridAdapter fills it; GenericGridAdapter sets the height. -->
<com.limelight.ui.GridCover xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:descendantFocusability="blocksDescendants">
    <com.limelight.ui.CoverFrame android:id="@+id/console_cover_frame" android:layout_width="match_parent" android:layout_height="160dp">
        <com.limelight.ui.PosterImageView android:id="@+id/grid_image" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <com.limelight.ui.NoArtTile android:id="@+id/grid_text" android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <com.limelight.ui.StatusDisc android:id="@+id/grid_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" android:layout_margin="7dp" android:visibility="gone" android:importantForAccessibility="no" />
        <com.limelight.ui.MarqueeLabel android:id="@+id/grid_role" style="@style/Widget.Nightjar.CardChip" android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/space_s" android:maxLines="1" android:ellipsize="end" android:drawablePadding="@dimen/space_xs"
            android:visibility="gone" android:importantForAccessibility="no" />
    </com.limelight.ui.CoverFrame>
</com.limelight.ui.GridCover>
