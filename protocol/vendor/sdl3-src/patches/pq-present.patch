+// Nightjar patch (PQ present): the PQ pass reads an RGBA16F back buffer.
+static SDL_GPUTextureFormat GPU_BackbufferFormat(GPU_RenderData *data, SDL_Window *window)
+{
+    return data->pq.pipeline ? SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT : SDL_GetGPUSwapchainTextureFormat(data->device, window);
+}
+
+// Nightjar patch (PQ present): the app's SPIR-V vertex and fragment shaders (entry points
+// "vertex" and "fragment", one sampler) and their pipeline for the HDR10 swapchain.
+static bool GPU_CreatePQPresent(GPU_RenderData *data, SDL_Window *window, const void *vertex, size_t vertex_size, const void *fragment, size_t fragment_size)
+{
+    SDL_GPUShaderCreateInfo sci;
+    SDL_GPUColorTargetDescription target;
+    SDL_GPUGraphicsPipelineCreateInfo pci;
+
+    if (!(SDL_GetGPUShaderFormats(data->device) & SDL_GPU_SHADERFORMAT_SPIRV)) {
+        return SDL_SetError("The PQ present needs SPIR-V shaders");
+    }
+    if (SDL_GetGPUSwapchainTextureFormat(data->device, window) != SDL_GPU_TEXTUREFORMAT_R10G10B10A2_UNORM) {
+        return SDL_SetError("The HDR10 swapchain is not RGB10A2");
+    }
+
+    SDL_zero(sci);
+    sci.format = SDL_GPU_SHADERFORMAT_SPIRV;
+    sci.code = (const Uint8 *)vertex;
+    sci.code_size = vertex_size;
+    sci.entrypoint = "vertex";
+    sci.stage = SDL_GPU_SHADERSTAGE_VERTEX;
+    data->pq.vertex = SDL_CreateGPUShader(data->device, &sci);
+    if (!data->pq.vertex) {
+        return false;
+    }
+    sci.code = (const Uint8 *)fragment;
+    sci.code_size = fragment_size;
+    sci.entrypoint = "fragment";
+    sci.stage = SDL_GPU_SHADERSTAGE_FRAGMENT;
+    sci.num_samplers = 1;
+    data->pq.fragment = SDL_CreateGPUShader(data->device, &sci);
+    if (!data->pq.fragment) {
+        return false;
+    }
+
+    SDL_zero(target);
+    target.format = SDL_GPU_TEXTUREFORMAT_R10G10B10A2_UNORM;
+    SDL_zero(pci);
+    pci.vertex_shader = data->pq.vertex;
+    pci.fragment_shader = data->pq.fragment;
+    pci.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+    pci.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
+    pci.rasterizer_state.cull_mode = SDL_GPU_CULLMODE_NONE;
+    pci.target_info.num_color_targets = 1;
+    pci.target_info.color_target_descriptions = &target;
+    data->pq.pipeline = SDL_CreateGPUGraphicsPipeline(data->device, &pci);
+    return data->pq.pipeline != NULL;
+}
