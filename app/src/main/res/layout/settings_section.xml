<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp"
    android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="16dp" android:paddingBottom="16dp"
    android:descendantFocusability="blocksDescendants" android:background="?android:attr/selectableItemBackground">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@android:id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/on_surface" />
        <TextView android:id="@android:id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="@color/on_surface_variant" />
    </LinearLayout>
    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp"
        android:src="@drawable/settings_chevron" android:importantForAccessibility="no" />
</LinearLayout>
