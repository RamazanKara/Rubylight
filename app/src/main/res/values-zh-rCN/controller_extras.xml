    <!-- USB Switch Pro driver -->
    <string name="title_usb_switch_pro">USB Switch Pro 驱动</string>
    <string name="summary_usb_switch_pro">Nightjar 自行读取有线连接的 Switch Pro Controller，让陀螺仪、震动、Home 和 Capture 都能使用。串流时 Android 会请求 USB 访问权限；蓝牙连接和 Joy-Con 仍使用 Android 的输入。</string>
    <string name="usb_switch_pro_denied">没有 USB 访问权限；Switch Pro Controller 继续使用 Android 输入。\n请重新连接数据线后重试。</string>
