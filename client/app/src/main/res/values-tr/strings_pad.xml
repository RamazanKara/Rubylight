    <string name="osc_stick_fixed">Fixed</string>
    <string name="title_seekbar_osc_stick_deadzone">Modern controller stick deadzone</string>
    <string name="summary_seekbar_osc_stick_deadzone">Çubuk tepki vermeden önce başparmağın ne kadar hareket ettiği. Duran başparmak kamerayı veya karakteri kaydırıyorsa artırın; daha hassas nişan için azaltın.</string>
