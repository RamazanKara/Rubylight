<?xml version="1.0" encoding="utf-8"?>
<!-- A failed connection: the words as they are, a moon Try again, the test of the network, and Back. -->
<com.limelight.ui.GlassSurface xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/conn_panel"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
    app:glassMaterial="panel" app:glassRadius="@dimen/nj_radius_sheet" android:clipChildren="false">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true"
        android:scrollbars="none" android:clipToPadding="false" android:clipChildren="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="20dp" android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_glass_alert"
                    android:background="@drawable/glass_alert_disc" android:padding="9dp" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/conn_error_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:accessibilityHeading="true" android:accessibilityLiveRegion="assertive"
                        android:textAppearance="@style/TextAppearance.Nightjar.Title" android:textColor="?attr/colorOnSurface" />
                    <TextView android:id="@+id/conn_error_what" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                        android:textAppearance="@style/TextAppearance.Nightjar.Caption" android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/conn_error_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/conn_test_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone"
                android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.limelight.ui.GlassButton android:id="@+id/conn_retry" style="@style/Widget.Nightjar.Glass.Play"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="48dp"
                android:nextFocusDown="@+id/conn_test" app:icon="@null" android:text="@string/pair_try_again" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal"
                android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false">
                <com.limelight.ui.GlassButton android:id="@+id/conn_test" style="@style/Widget.Nightjar.Glass.Control"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:nextFocusUp="@id/conn_retry"
                    android:text="@string/conn_test_network" />
                <com.google.android.material.progressindicator.CircularProgressIndicator xmlns:app2="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/conn_test_working" android:layout_width="wrap_content" android:layout_height="wrap_content" android:indeterminate="true"
                    android:layout_marginStart="8dp" android:visibility="gone" android:importantForAccessibility="no"
                    app:indicatorSize="18dp" app:trackThickness="2dp" app:indicatorColor="?attr/colorOnSurfaceVariant" />
                <com.limelight.ui.GlassButton android:id="@+id/conn_back" style="@style/Widget.Nightjar.Glass.Control"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:minWidth="88dp"
                    android:nextFocusUp="@id/conn_retry" android:text="@string/conn_back" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.limelight.ui.GlassSurface>
