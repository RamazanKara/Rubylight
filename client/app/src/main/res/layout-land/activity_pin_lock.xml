<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape and TV: one panel in the middle, the prompt and slots on the left, the pad on the right. Same ids as the portrait
     layout. -->
<com.limelight.ui.GlassHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pin_root"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <com.limelight.ui.NightSkyView android:id="@+id/pin_sky"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <FrameLayout android:id="@+id/pin_panel"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical"
            android:padding="@dimen/space_l">
            <LinearLayout android:layout_width="@dimen/pin_pad_width" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:paddingStart="@dimen/space_s" android:paddingEnd="@dimen/space_s">
                <TextView android:id="@+id/pin_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Nightjar.ScreenTitle"
                    android:textColor="?attr/colorOnSurface" android:accessibilityHeading="true" />
                <TextView android:id="@+id/pin_subtitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs" android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Nightjar.Supporting"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <com.limelight.ui.PinSlots android:id="@+id/pin_dots"
                    android:layout_width="@dimen/pin_pad_width" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l" />
                <TextView android:id="@+id/pin_status"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:minHeight="@dimen/space_xl" android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Nightjar.Supporting"
                    android:textColor="?attr/colorOnSurfaceVariant" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <ScrollView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl" android:layout_marginEnd="@dimen/space_s"
                android:clipToPadding="false">
                <include layout="@layout/view_pin_pad" />
            </ScrollView>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/pin_cancel"
            style="?attr/nightjarPinKeyStyle" app:icon="@drawable/ic_close" app:iconGravity="textStart" app:iconPadding="0dp"
            android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target"
            android:layout_gravity="top|start" android:layout_margin="@dimen/space_m" />
    </FrameLayout>
</com.limelight.ui.GlassHost>
