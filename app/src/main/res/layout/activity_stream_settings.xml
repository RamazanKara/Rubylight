<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="64dp" android:padding="8dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/settings_back" style="@style/ToolbarIcon"
            android:nextFocusDown="@+id/settings_search"
            android:src="@drawable/ic_arrow_back" android:contentDescription="@string/settings_navigate_up" />
        <TextView android:id="@+id/settings_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:textAppearance="@style/ScreenTitle"
            android:accessibilityHeading="true" tools:targetApi="p" android:text="@string/settings" />
    </LinearLayout>
    <androidx.appcompat.widget.SearchView android:id="@+id/settings_search"
        android:nextFocusUp="@id/settings_back" android:nextFocusDown="@android:id/list"
        android:accessibilityTraversalAfter="@id/settings_back"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:background="@drawable/settings_search_background"
        app:queryBackground="@android:color/transparent" app:submitBackground="@android:color/transparent"
        app:iconifiedByDefault="false" />
    <TextView android:id="@+id/settings_context"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/on_surface_variant"
        android:accessibilityLiveRegion="polite" />
    <FrameLayout android:id="@+id/stream_settings"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
