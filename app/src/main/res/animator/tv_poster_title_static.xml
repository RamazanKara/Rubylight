<?xml version="1.0" encoding="utf-8"?>
<!-- Reduced motion: the title shows and hides with the focus, without fading. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1" android:duration="0" android:valueType="floatType" />
    </item>
    <item android:state_focused="true" android:state_enabled="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1" android:duration="0" android:valueType="floatType" />
    </item>
    <item android:state_selected="true" android:state_enabled="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1" android:duration="0" android:valueType="floatType" />
    </item>
    <item android:state_hovered="true" android:state_enabled="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1" android:duration="0" android:valueType="floatType" />
    </item>
    <item>
        <objectAnimator android:propertyName="alpha" android:valueTo="0" android:duration="0" android:valueType="floatType" />
    </item>
</selector>
