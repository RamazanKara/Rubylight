<resources>
    <string name="title_adaptive_quality">Automatic stream quality</string>
    <string name="summary_adaptive_quality">Lower resolution or FPS during sustained congestion, slow decoding or heat, then recover gradually. Uses automatic bitrate when supported. Needs a PC that can change a running stream and an adaptive decoder; unavailable with PyroWave.</string>
    <string name="title_adaptive_quality_min_resolution">Minimum resolution</string>
    <string name="summary_adaptive_quality_min_resolution">The lowest resolution Automatic quality goes to.</string>
    <string name="title_adaptive_quality_min_fps">Minimum frame rate</string>
    <string name="summary_adaptive_quality_min_fps">The lowest frame rate Automatic quality goes to.</string>
    <string name="quality_off">Off</string>
    <string name="quality_motion">Preserve motion</string>
    <string name="quality_detail">Preserve detail</string>
    <string name="quality_battery">Extend battery life</string>
    <string name="quality_use_settings">Use app settings</string>
    <string name="quality_about">How it works</string>
    <string name="quality_stream_help">Saved for this PC. Motion lowers resolution first; Detail lowers FPS first. Battery gradually limits work to at most 60 FPS and a 1080-pixel short edge, within your minimum limits. Codec, HDR and the display choice stay as negotiated.</string>
    <string name="quality_unavailable">Automatic quality is off: this PC or device can’t change resolution and frame rate during a stream.</string>
    <string name="quality_request_failed">Automatic quality stopped: the PC didn’t apply the new size. The stream goes on; pick another mode in the stream menu.</string>
    <string name="quality_status">Automatic quality: %1$s · %2$d × %3$d · target %4$d FPS</string>
