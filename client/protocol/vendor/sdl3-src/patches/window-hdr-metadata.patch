+/* Nightjar patch (HDR metadata): an HDR10 swapchain takes the window's mastering metadata, a
+ * VkHdrMetadataEXT the app keeps in the window property SDL.window.gpu.hdr_metadata_pointer,
+ * each time SDL.window.gpu.hdr_metadata_serial changes and on each new swapchain, before its next
+ * image. The app clears the pointer for unknown metadata, and only metadata whose maxLuminance is
+ * above its minLuminance is passed on: compositors (KWin, wlroots) end a client sending
+ * min >= max. Vulkan cannot take metadata back, so a swapchain that had some keeps it until it is
+ * made again. */
+static void VULKAN_INTERNAL_SetWindowHdrMetadata(VulkanRenderer *renderer, WindowData *windowData, SDL_Window *window)
+{
+    if (renderer->supports.EXT_hdr_metadata && renderer->vkSetHdrMetadataEXT &&
+        windowData->swapchainComposition == SDL_GPU_SWAPCHAINCOMPOSITION_HDR10_ST2084) {
+        SDL_PropertiesID windowProps = SDL_GetWindowProperties(window);
+        Sint64 serial = SDL_GetNumberProperty(windowProps, "SDL.window.gpu.hdr_metadata_serial", 0);
+        if (serial != windowData->hdrMetadataSerial) {
+            const VkHdrMetadataEXT *metadata = (const VkHdrMetadataEXT *)SDL_GetPointerProperty(windowProps, "SDL.window.gpu.hdr_metadata_pointer", NULL);
+            if (metadata && metadata->maxLuminance > metadata->minLuminance) {
+                renderer->vkSetHdrMetadataEXT(renderer->logicalDevice, 1, &windowData->swapchain, metadata);
+            }
+            windowData->hdrMetadataSerial = serial;
+        }
+    }
+}
