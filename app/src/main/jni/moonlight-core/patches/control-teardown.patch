+static bool sendMessageEnet(short ptype, short paylen, const void* payload, uint8_t channelId, uint32_t flags, bool moreData) {
+    bool ret = false;
+
+    // Controller audio, display and reconfigure messages come from Java threads that the
+    // stream never joins. Count every sender so teardown can wait for it before destroying
+    // the peer, and start none once teardown has closed sending.
+    atomic_fetch_add(&enetSendersInFlight, 1);
+    if (!atomic_load(&enetSendsClosed)) {
+        ret = sendMessageEnetInternal(ptype, paylen, payload, channelId, flags, moreData);
+    }
+    atomic_fetch_sub(&enetSendersInFlight, 1);
+    return ret;
+}
+
+// Stops new sends and waits for the ones already in flight, before the peer is destroyed.
+static void closeEnetSends(void) {
+    atomic_store(&enetSendsClosed, true);
+    while (atomic_load(&enetSendersInFlight) != 0) {
+        PltSleepMs(1);
+    }
+}
