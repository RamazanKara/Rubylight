<resources>
    <string name="title_adaptive_quality">自动串流画质</string>
    <string name="summary_adaptive_quality">在持续拥塞、解码缓慢或发热时降低分辨率或 FPS，然后逐步恢复。支持时会使用自动码率。需要能更改运行中串流的电脑和自适应解码器；PyroWave 下不可用。</string>
    <string name="title_adaptive_quality_min_resolution">最低分辨率</string>
    <string name="summary_adaptive_quality_min_resolution">“自动画质”可降到的最低分辨率。</string>
    <string name="title_adaptive_quality_min_fps">最低帧率</string>
    <string name="summary_adaptive_quality_min_fps">“自动画质”可降到的最低帧率。</string>
    <string name="quality_off">关闭</string>
