+            // The intercept held back a disconnect the host has already sent, or the host has
+            // been silent too long (a PC that is gone). Neither will acknowledge ours, so a
+            // graceful disconnect would wait out the whole linger.
             enet_peer_disconnect_now(peer, 0);
         }
         else {
