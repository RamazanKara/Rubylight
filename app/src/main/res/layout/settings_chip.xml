<?xml version="1.0" encoding="utf-8"?>
<!-- A section's chip on a phone: a flat tint, the selected fill while its section shows. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="40dp"
    android:gravity="center" android:paddingStart="@dimen/space_l" android:paddingEnd="@dimen/space_l"
    android:layout_marginEnd="@dimen/space_s"
    android:focusable="true" android:clickable="true" android:maxLines="1" android:defaultFocusHighlightEnabled="false"
    android:background="@drawable/settings_chip" android:fontFamily="?attr/nightjarFaceStrong"
    android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="@color/settings_chip_text" />
