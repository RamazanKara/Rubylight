<?xml version="1.0" encoding="utf-8"?>
<!-- Settings on a TV: the night sky, the rail, one column, no cap. The glass chrome is view_settings_chrome, which keeps the full
     size while the panes are compact (StreamSettings.setUpGlass). -->
<com.limelight.ui.GlassHost xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/glass_host" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/settings_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipChildren="false" android:clipToPadding="false">
        <com.limelight.ui.NightSkyView android:id="@+id/settings_sky" android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <com.limelight.ui.ContentFrame android:layout_width="match_parent" android:layout_height="match_parent" android:maxWidth="4096dp">
            <LinearLayout android:id="@+id/settings_frame"
                android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                <include android:id="@+id/settings_toolbar" layout="@layout/view_settings_bar" />
                <androidx.appcompat.widget.SearchView android:id="@+id/settings_search"
                    android:nextFocusDown="@android:id/list" android:visibility="gone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:layout_marginStart="@dimen/shell_inset" android:layout_marginEnd="@dimen/shell_inset"
                    android:layout_marginBottom="@dimen/space_s"
                    android:background="@drawable/settings_search_background"
                    app:queryBackground="@android:color/transparent" app:submitBackground="@android:color/transparent"
                    app:iconifiedByDefault="false" />
                <!-- Two panes: the sections on the left (RootFragment), the chosen section or the search results on the right. -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:orientation="horizontal" android:baselineAligned="false">
                    <!-- The rail: over its sky the selected pill of the current section (SettingsRail), then its list. -->
                    <FrameLayout android:id="@+id/settings_rail"
                        android:layout_width="@dimen/settings_rail_width" android:layout_height="match_parent">
                        <View android:id="@+id/settings_rail_bar" android:layout_width="match_parent" android:layout_height="@dimen/settings_section_min_height"
                            android:layout_marginStart="@dimen/screen_gutter" android:layout_marginEnd="@dimen/screen_gutter"
                            android:background="@drawable/tv_rail_bar"
                            android:visibility="invisible" android:importantForAccessibility="no" />
                        <FrameLayout android:id="@+id/settings_sections"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:nextFocusRight="@id/stream_settings" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/settings_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:paddingStart="@dimen/settings_title_inset" android:paddingEnd="@dimen/settings_title_inset" android:paddingBottom="@dimen/space_s"
                            android:maxLines="1" android:ellipsize="end" android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.Nightjar.Glass.PaneTitle"
                            android:fontFamily="?attr/nightjarFaceStrong" android:letterSpacing="-0.01" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/settings_context"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:paddingStart="@dimen/settings_title_inset" android:paddingEnd="@dimen/settings_title_inset" android:paddingBottom="@dimen/space_s"
                            android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant"
                            android:accessibilityLiveRegion="polite" />
                        <FrameLayout android:id="@+id/stream_settings"
                            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                            android:nextFocusLeft="@id/settings_sections" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.limelight.ui.ContentFrame>
        <View android:id="@+id/settings_foot_fade" android:layout_width="match_parent" android:layout_height="@dimen/home_foot_fade"
            android:layout_gravity="bottom" android:importantForAccessibility="no" />
    </FrameLayout>
</com.limelight.ui.GlassHost>
