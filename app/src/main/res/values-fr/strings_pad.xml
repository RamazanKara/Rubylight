    <string name="title_list_osc_stick_mode">Modern controller sticks</string>
    <string name="summary_list_osc_stick_mode">« Floating » centre un stick là où votre pouce se pose, sans avoir à le viser exactement. Choisissez « Fixed » si vous préférez viser le stick dessiné.</string>
