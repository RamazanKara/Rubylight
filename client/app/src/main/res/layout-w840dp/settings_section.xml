<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the side rail: its icon and name, in the selected fill while it is the section shown. The pane says the rest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/settings_rail_row"
    android:gravity="center_vertical" android:paddingStart="@dimen/space_m" android:paddingEnd="@dimen/space_m"
    android:descendantFocusability="blocksDescendants" android:background="@drawable/settings_rail_row">
    <ImageView android:id="@android:id/icon" android:layout_width="20dp" android:layout_height="20dp"
        android:layout_marginEnd="@dimen/space_m" app:tint="@color/tv_rail_icon" android:duplicateParentState="true"
        android:importantForAccessibility="no" />
    <TextView android:id="@android:id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:maxLines="2" android:ellipsize="end" android:duplicateParentState="true"
        android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="@color/tv_rail_title" />
</LinearLayout>
