<?xml version="1.0" encoding="utf-8"?>
<!-- All games: the library of every paired host as one poster grid under a row of filters (All, Installed, each store,
     Other apps, Not added). Above the grid, the focused poster's title and line, since a TV poster carries no text.
     On a TV it stands on the night sky of the other pages, and the grid fades out under the heading. The top row is Home's:
     the tabs in glass, then the PC capsule and Search, whose field takes the row's place. A phone keeps its tabs across the
     top, and the capsule and Search stand at the end of the title's line. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<com.limelight.ui.NightSkyView android:id="@+id/all_games_sky" android:layout_width="match_parent" android:layout_height="match_parent"
    android:importantForAccessibility="no" android:visibility="gone" />
<LinearLayout android:id="@+id/all_games_page"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:clipChildren="false" android:clipToPadding="false"
    android:paddingStart="@dimen/shell_overscan_horizontal" android:paddingEnd="@dimen/shell_overscan_horizontal"
    android:paddingTop="@dimen/shell_overscan_vertical">
    <include android:id="@+id/all_games_toolbar" layout="@layout/view_top_app_bar" android:visibility="gone" />
    <FrameLayout android:id="@+id/all_games_top" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:id="@+id/all_games_top_row" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false">
            <com.limelight.ui.GlassSurface android:id="@+id/all_games_tabs" android:layout_width="wrap_content"
                android:layout_height="@dimen/glass_capsule">
                <include layout="@layout/view_shell_bar" android:layout_width="wrap_content" android:layout_height="match_parent" />
            </com.limelight.ui.GlassSurface>
            <Space android:id="@+id/all_games_top_spacer" android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <LinearLayout android:id="@+id/all_games_tools" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false">
                <com.limelight.ui.GlassSurface android:id="@+id/all_games_pc" android:layout_width="wrap_content" android:layout_height="@dimen/glass_capsule"
                    android:focusable="true" android:clickable="true" android:defaultFocusHighlightEnabled="false" android:visibility="gone">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal"
                        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="14dp">
                        <View android:id="@+id/home_pc_dot" android:layout_width="9dp" android:layout_height="9dp" />
                        <TextView android:id="@+id/home_pc_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="9dp" android:layout_marginEnd="6dp" android:maxLines="1" android:ellipsize="end" android:maxWidth="220dp"
                            android:textAppearance="@style/TextAppearance.Nightjar.Glass.Capsule" android:textColor="?attr/colorOnSurface" />
                        <ImageView android:layout_width="17dp" android:layout_height="17dp" android:src="@drawable/ic_glass_down"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </com.limelight.ui.GlassSurface>
                <com.limelight.ui.GlassSurface android:id="@+id/all_games_search" android:layout_width="@dimen/glass_capsule" android:layout_height="@dimen/glass_capsule"
                    android:layout_marginStart="8dp" android:focusable="true" android:clickable="true" android:defaultFocusHighlightEnabled="false"
                    android:contentDescription="@string/library_search">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                        android:src="@drawable/ic_glass_search" android:importantForAccessibility="no" />
                </com.limelight.ui.GlassSurface>
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/view_home_search_bar" />
    </FrameLayout>
    <ProgressBar android:id="@+id/all_games_loading" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true"
        android:visibility="invisible" />
    <LinearLayout android:id="@+id/all_games_title_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="@dimen/space_xs"
        android:clipChildren="false" android:clipToPadding="false">
        <TextView android:id="@+id/all_games_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingStart="@dimen/space_s" android:paddingEnd="@dimen/space_s"
            android:text="@string/console_all_games_title" android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Nightjar.ScreenTitle" android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/all_games_filters_scroll"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s"
        android:scrollbars="none" android:overScrollMode="never" android:clipToPadding="false"
        android:focusable="false" android:paddingStart="@dimen/space_s" android:paddingEnd="@dimen/space_s"
        android:paddingTop="2dp" android:paddingBottom="2dp">
        <LinearLayout android:id="@+id/all_games_filters" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" />
    </HorizontalScrollView>
    <!-- Read by the focus, never focused: a screen reader reads the card, which says the same. -->
    <LinearLayout android:id="@+id/all_games_focus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="@dimen/space_m"
        android:paddingStart="@dimen/space_s" android:paddingEnd="@dimen/space_s"
        android:importantForAccessibility="noHideDescendants">
        <TextView android:id="@+id/all_games_focus_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:id="@+id/all_games_focus_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Nightjar.Title" android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
    <!-- As on Home, the grid reaches 24 dp past the content on both sides so a focused poster's ring and glow show whole. -->
    <com.limelight.console.GridFrame android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginStart="-24dp" android:layout_marginEnd="-24dp" android:layout_marginTop="@dimen/space_xs"
        android:clipChildren="true">
        <com.limelight.console.TopFadeRecyclerView android:id="@+id/all_games_grid"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_xxl" android:focusable="false"
            android:descendantFocusability="afterDescendants" />
        <TextView android:id="@+id/all_games_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="@dimen/space_xl"
            android:text="@string/console_all_games_empty" android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="?attr/colorOnSurfaceVariant" />
    </com.limelight.console.GridFrame>
</LinearLayout>
</FrameLayout>
