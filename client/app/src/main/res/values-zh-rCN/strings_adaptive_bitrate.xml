<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="stream_auto_bitrate_help">根据你的网络连接调整码率。\n按此电脑保存；手动更改会将其关闭。</string>
    <string name="stream_pyrowave_bitrate_help">为此电脑自动调整 PyroWave。\n手动设置码率会将其关闭。</string>
    <string name="stream_auto_bitrate_failed">码率暂时更新失败。正在自动重试。</string>
    <string name="stream_auto_bitrate_unavailable">此电脑不报告串流码率。此串流的“网络繁忙时降低码率”已关闭。</string>
    <string name="stream_auto_bitrate_status">当前码率：%1$.1f Mbps</string>
    <string name="stream_bitrate_busy">电脑繁忙。请稍后重试。</string>
    <string name="stream_host_abr_failed">电脑未启动其自动码率：%1$s</string>
    <string name="title_auto_bitrate">网络繁忙时降低码率</string>
    <string name="dialog_auto_bitrate">连接跟不上时降低码率，恢复后再调回：画面会模糊一些，但卡顿更少。网络繁忙时请开启；需要电脑支持。</string>
    <string name="title_thermal_protection">过热保护</string>
    <string name="dialog_thermal_protection">设备发热时降低码率和分辨率，前提是已开启“网络繁忙时降低码率”或“自动画质”。仅在设备降频或过热时开启。</string>
    <string name="title_automatic_bitrate">自动码率</string>
    <string name="dialog_automatic_bitrate">Nightjar 根据分辨率、帧率和编解码器选择码率，并在它们变化时随之调整。关闭后可自行设置码率。</string>
</resources>
