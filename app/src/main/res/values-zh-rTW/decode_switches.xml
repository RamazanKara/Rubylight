<resources>
    <string name="title_submit_hint">加快影格交付</string>
    <string name="summary_submit_hint">效能提示也涵蓋將影格交給解碼器的執行緒。</string>
    <string name="title_covering_decoder_size">為折疊準備解碼器</string>
    <string name="summary_covering_decoder_size">預先依另一個螢幕和旋轉後的尺寸設定解碼器，折疊或旋轉時不必重新啟動。</string>
