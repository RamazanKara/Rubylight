<?xml version="1.0" encoding="utf-8"?>
<!-- "Search settings" at the top of TV Settings' rail. Marked while the right pane shows search results, it looks like a
     current section row (layout-television/settings_section): the amber bar, an amber icon and title, no fill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target"
    android:gravity="center_vertical" android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_m" android:paddingBottom="@dimen/space_m"
    android:descendantFocusability="blocksDescendants" android:background="@drawable/tv_settings_rail_row">
    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="@dimen/space_l"
        android:src="@drawable/ic_library_search" app:tint="@color/tv_rail_icon" android:duplicateParentState="true"
        android:importantForAccessibility="no" />
    <TextView android:id="@android:id/title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textAppearance="@style/TextAppearance.Nightjar.Body"
        android:textColor="@color/tv_rail_title" />
</LinearLayout>
