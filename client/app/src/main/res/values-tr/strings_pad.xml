    <string name="osc_style_modern">Modern</string>
    <string name="title_list_osc_stick_mode">Modern controller sticks</string>
    <string name="summary_list_osc_stick_mode">“Floating” çubuğu başparmağınızın değdiği yerde ortalar; tam üstüne basmanız gerekmez. Çizili çubuğu hedeflemeyi tercih ediyorsanız “Fixed” seçin.</string>
