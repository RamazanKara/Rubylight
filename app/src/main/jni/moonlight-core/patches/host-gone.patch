Tell a host's goodbye from a timeout, and stop toward a silent host without lingering.
LiHostSaidGoodbye() is true when the host's own disconnect ended the connection (the held one,
once ENet acts on it, or one sent with enet_peer_disconnect_now()), and false for ENet's timeout:
the client then asks whether the PC closed its server: it shuts down or its host stopped (HostLossWatch). The
stop skips the two-second linger toward a host silent for two seconds or more, which will not
acknowledge the disconnect. Applies after network-grace-input.patch.

--- a/src/ControlStream.c
+++ b/src/ControlStream.c
@@ -107,6 +107,8 @@
 static bool stopping;
 static bool disconnectPending;
 static bool disconnectPendingUnsequenced;
+// The host's own disconnect ended this connection, not a timeout (LiHostSaidGoodbye).
+static bool hostGoodbye;
 static int networkGracePeriodMs;
 static bool encryptedControlStream;
 static bool hdrEnabled;
@@ -149,6 +151,9 @@
 
 #define CONTROL_STREAM_TIMEOUT_SEC 10
 #define CONTROL_STREAM_LINGER_TIMEOUT_SEC 2
+// A host silent this long at the stop gets no linger: it will not acknowledge the disconnect. A
+// short blip toward a live host stays below it, so a clean stop still reaches it.
+#define CONTROL_STREAM_SILENT_STOP_MS 2000
 
 static const short packetTypesGen3[] = {
     0x1407, // Request IDR frame
@@ -361,6 +366,7 @@
     lastGoodFrame = 0;
     lastSeenFrame = 0;
     disconnectPending = false;
+    hostGoodbye = false;
     intervalGoodFrameCount = 0;
     intervalTotalFrameCount = 0;
     intervalStartTimeMs = 0;
@@ -750,6 +756,10 @@
     return lastReceiveTime != 0 && ENET_TIME_DIFFERENCE(enet_time_get(), lastReceiveTime) >= INPUT_CONTACT_LOST_MS;
 }
 
+bool LiHostSaidGoodbye(void) {
+    return hostGoodbye;
+}
+
